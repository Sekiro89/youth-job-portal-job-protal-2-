<section class="about-section" id="quick-answers" aria-labelledby="quick-h">
  <div class="container">
    <p class="eyebrow">Quick answers</p>
    <h2 id="quick-h">Straight answers, no scrolling required</h2>
  </div>
  <dl class="container about-quick">
    <% quick.forEach(({ q, a }) => { %>
      <div class="about-quick__item">
        <dt><%= q %></dt>
        <dd><%= a %></dd>
      </div>
    <% }) %>
  </dl>
</section>
