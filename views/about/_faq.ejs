<section class="about-section" id="faq" aria-labelledby="faq-h">
  <h2 id="faq-h">Frequently asked questions</h2>
  <p class="prose">Straight answers about pricing, GST, cancellation, consultants, resumes, alerts, accessibility and privacy. Still unsure? <a href="/contact">Contact us</a>.</p>
  <div class="faq">
    <% faq.forEach(({ q, a, more }, i) => { %>
      <details class="card faq__item" id="faq-<%= i + 1 %>">
        <summary><span><%= q %></span></summary>
        <div class="faq__body">
          <p><%= a %></p>
          <% if (more) { %><p class="faq__more"><a href="<%= more.href %>"><%= more.label %> →</a></p><% } %>
        </div>
      </details>
    <% }) %>
  </div>
</section>
