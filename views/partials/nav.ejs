<% const tabs = [
  ['/employer', 'Employer'],
  ['/consultant', 'Third Party Consultant'],
  ['/jobseeker', 'Job Seeker'],
  ['/about', 'About Us'],
  ['/contact', 'Contact Us'],
]; const isActive = (p) => path === p || path.startsWith(p + '/'); %>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-logo" href="/" aria-label="<%= (typeof site !== 'undefined' && site.site_name) || 'Youth Futures Canada' %> home">
      <img src="/img/logo-mark.png" alt="" width="80" height="80">
      <span class="site-logo__word"><b>Youth Futures</b><span>Canada</span></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Primary">
      <ul class="site-nav__tabs">
        <li><a href="/jobs" class="<%= isActive('/jobs') ? 'is-active' : '' %>">Job Bank</a></li>
        <% tabs.forEach(([href, label]) => { %>
          <li><a href="<%= href %>" class="<%= isActive(href) ? 'is-active' : '' %>"><%= label %></a></li>
        <% }) %>
      </ul>
      <div class="site-nav__auth">
        <% if (user) { %>
          <a class="kds-btn kds-btn--ghost" href="<%= ({employer:'/employer/dashboard',consultant:'/consultant/dashboard',seeker:'/jobseeker/dashboard',admin:'/admin'})[user.role] %>">
            <span class="avatar" aria-hidden="true"><%= (user.name||'?').trim()[0].toUpperCase() %></span><span class="nav-label">My account</span><span class="visually-hidden">My account</span>
          </a>
          <form method="post" action="/logout" class="inline-form"><button class="kds-btn kds-btn--ghost" type="submit" aria-label="Sign out">Sign out</button></form>
        <% } else { %>
          <a class="kds-btn kds-btn--ghost" href="/login">Sign in</a>
          <a class="kds-btn kds-btn--brand" href="/signup">Sign up</a>
        <% } %>
      </div>
    </nav>
  </div>
</header>
