<footer class="site-footer">
  <div class="container site-footer__statement">
    <img src="/img/logo-mark.png" alt="" width="56" height="56" class="site-footer__mark">
    <p class="site-footer__tagline">Our dreams. Our skills.<br>Our future. Our Canada.</p>
  </div>
  <div class="site-footer__rule"></div>
  <div class="container site-footer__links">
    <nav aria-label="Employers"><h3>Employers</h3>
      <ul><li><a href="/employer">Post a job</a></li><li><a href="/employer#pricing">Pricing — $14.99/month + GST per posting</a></li><li><a href="/consultant">Third Party Consultant — $9.99/month + GST</a></li></ul></nav>
    <nav aria-label="Job seekers"><h3>Job seekers</h3>
      <ul><li><a href="/jobs">Browse all jobs</a></li><li><a href="/jobseeker">Create your profile</a></li><li><a href="/jobseeker#alerts">Job alerts</a></li></ul></nav>
    <nav aria-label="Company"><h3>Youth Futures Canada</h3>
      <ul><li><a href="/about">About us</a></li><li><a href="/contact">Contact us</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/terms">Terms</a></li></ul></nav>
    <% if (typeof site !== 'undefined' && (site.contact_phone || site.contact_address)) { %>
    <div class="site-footer__contact"><h3>Contact</h3>
      <p><% if (site.contact_address) { %><%= site.contact_address %><br><% } %><% if (site.contact_phone) { %><a href="tel:<%= site.contact_phone.replace(/[^+0-9]/g,'') %>"><%= site.contact_phone %></a><% } %></p>
    </div>
    <% } %>
  </div>
  <div class="container site-footer__legal">
    <p>© <%= new Date().getFullYear() %> <%= (typeof site !== 'undefined' && site.site_name) || 'Youth Futures Canada' %></p>
    <p>All prices in Canadian dollars; GST applies.</p>
  </div>
</footer>
