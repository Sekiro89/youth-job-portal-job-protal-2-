<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a class="footer-brand__logo" href="/" aria-label="<%= (typeof site !== 'undefined' && site.site_name) || 'Youth Careers Canada' %> home">
        <img src="/img/youthcareersnew.png" alt="<%= (typeof site !== 'undefined' && site.site_name) || 'Youth Careers Canada' %>" width="1311" height="738">
      </a>
      <p class="footer-brand__tagline">Our dreams.<br>Our skills.<br>Our future.<br>Our Canada.</p>
    </div>
    <div class="footer-nav">
      <nav aria-label="Employers"><h3>Employers</h3>
        <ul><li><a href="/employer">Post a job</a></li><li><a href="/employer#pricing">Pricing — $14.99/month + GST per posting</a></li><li><a href="/consultant">Third Party Consultant — $9.99/month + GST</a></li></ul></nav>
      <nav aria-label="Job seekers"><h3>Job seekers</h3>
        <ul><li><a href="/jobs">Browse all jobs</a></li><li><a href="/jobseeker">Create your profile</a></li><li><a href="/jobseeker#alerts">Job alerts</a></li></ul></nav>
      <nav aria-label="Youth Careers Canada"><h3>Youth Careers Canada</h3>
        <ul><li><a href="/about">About us</a></li>
        <% if (typeof site !== 'undefined' && (site.contact_phone || site.contact_address)) { %>
          <% if (site.contact_address) { %><li class="footer-nav__meta"><%= site.contact_address %></li><% } %>
          <% if (site.contact_phone) { %><li><a href="tel:<%= site.contact_phone.replace(/[^+0-9]/g,'') %>"><%= site.contact_phone %></a></li><% } %>
        <% } %>
        </ul></nav>
    </div>
  </div>
  <div class="container footer-utility">
    <ul class="footer-utility__links">
      <li><a href="/privacy">Privacy</a></li>
      <li><a href="/terms">Terms</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
    <div class="footer-utility__meta">
      <p>© <%= new Date().getFullYear() %> <%= (typeof site !== 'undefined' && site.site_name) || 'Youth Careers Canada' %></p>
      <p>All prices in Canadian dollars; GST applies.</p>
    </div>
  </div>
</footer>
