<% extraCss.push('/css/landing.css') %>
<%
// Pricing copy is computed from lib/constants (the contract source), never from route locals: employers $14.99, consultants $9.99, + 5% GST.
const _gst = (c) => Math.round(c * C.PRICING.gst_rate), _d = (c) => '$' + (c / 100).toFixed(2);
const EMP = C.priceCentsFor('employer'), CON = C.priceCentsFor('consultant');
const PRICE_EMP = _d(EMP), TOTAL_EMP = _d(EMP + _gst(EMP)), PRICE_CON = _d(CON), TOTAL_CON = _d(CON + _gst(CON));
%>
<header class="page-head landing-head">
  <div class="container page-head__inner">
    <div>
      <p class="eyebrow">For employers</p>
      <h1>Meet the young talent building Canada's next workforce</h1>
      <p class="lead">Post once and reach students, co-op and internship candidates, new graduates, early-career hires and skilled young professionals — live in seconds, cancel any time.</p>
      <div class="page-head__actions landing-head__cta">
        <a class="kds-btn kds-btn--accent" href="/signup/employer">Post a job</a>
        <a class="kds-btn kds-btn--ghost" href="/login?role=employer">Employer sign in</a>
      </div>
    </div>
  </div>
</header>

<div class="landing-facts-band">
  <ul class="landing-facts container">
    <li><strong><%= PRICE_EMP %></strong><span>+ GST, per posting monthly</span></li>
    <li><strong>Seconds</strong><span>to go live after checkout</span></li>
    <li><strong>Monthly</strong><span>renewal, no contracts</span></li>
    <li><strong>Any time</strong><span>pause or cancel</span></li>
  </ul>
</div>

<section class="section" id="dashboard">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Your dashboard</p>
      <h2>Everything about hiring in one place</h2>
    </div>
    <ul class="landing-tiles landing-tiles--3">
      <li class="landing-tile"><span class="landing-tile__n">01</span><h3>Applicant tracking</h3><p>See every applicant, download resumes, shortlist and mark hires. Candidates are notified automatically as their status changes.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">02</span><h3>Pause, duplicate, repost</h3><p>Pause when you have enough applicants, duplicate a posting for a similar role, reactivate any time within the paid month.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">03</span><h3>Paperwork accounting won't question</h3><p>Every charge gets its own numbered GST receipt, sitting in Billing whenever someone needs to pull a PDF for the books.</p></li>
    </ul>
  </div>
</section>

<%- include('partials/landing-audiences', { mode: 'post' }) %>

<section class="section" id="how-it-works">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">How it works</p>
      <h2>From blank form to live posting, quickly</h2>
    </div>
    <ol class="landing-tiles landing-tiles--3">
      <li class="landing-tile"><span class="landing-tile__n">01</span><h3>Create your account</h3><p>Sign up with your company name and a contact. Add a logo and a short description so job seekers know who you are.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">02</span><h3>Fill in the details</h3><p>A title, where the work actually happens (list every site if there's more than one), what it pays and how often, languages needed, who it's aimed at and how people should apply. Nothing here has to be finished in one sitting — drafts save themselves.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">03</span><h3>Check out for <%= PRICE_EMP %> + GST</h3><p>The posting appears the moment payment clears, and keeps renewing at <%= TOTAL_EMP %> a month at that same locked-in rate until you say stop. Every applicant shows up in your dashboard as soon as they apply — pull the listing whenever the seat's filled.</p></li>
    </ol>
  </div>
</section>

<section class="section section--alt" id="posting">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">What every posting needs</p>
      <h2>Complete, transparent postings job seekers can trust</h2>
    </div>
    <ul class="landing-tiles landing-tiles--3">
      <li class="landing-tile"><span class="landing-tile__n">01</span><h3>Where the job actually is</h3><p>Not a city name — the real street, unit, postal code, the works. Hiring across more than one site? List them all on the same posting so nobody applies to the wrong location.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">02</span><h3>The name people actually know</h3><p>Whatever you're branded as day-to-day (say, "Flying Pig") leads the posting and your company page, with the registered legal entity noted underneath it — not the other way around.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">03</span><h3>Money and expectations, spelled out</h3><p>Pay and how often it lands (hourly through annual), the education and experience bar from standard Job Bank lists, an industry tag and an optional NOC code — all of it fits on one printable sheet.</p></li>
    </ul>
  </div>
</section>

<section class="section" id="targeting">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Who sees it first</p>
      <h2>Built to put you in front of young talent, not buried under it</h2>
    </div>
    <ul class="landing-tiles landing-tiles--3">
      <li class="landing-tile"><span class="landing-tile__n">01</span><h3>Career-stage sort, on by default</h3><p>Postings aimed at students, co-ops, new grads and early-career candidates rank ahead of senior roles in the Job Bank's default order — no setting to turn on, it's just how search results come back.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">02</span><h3>Nothing gets hidden</h3><p>Your posting still shows up for every search, filter and direct link regardless of career stage — the ranking shapes what's seen first, it never removes anyone from the results.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">03</span><h3>Tag the stage that fits</h3><p>Job type and experience level double as the career-stage signal, so a posting written honestly already reaches the right shortlist on <a href="/jobs">the Job Bank</a>.</p></li>
    </ul>
  </div>
</section>

<%- include('partials/landing-pricing', { signupHref: '/signup/employer', audienceLabel: 'employer', priceCents: EMP, otherLabel: 'Third Party Consultants', otherCents: CON }) %>

<%- include('partials/landing-faq', { items: faq, audienceLabel: 'employers' }) %>

<section class="section section--alt">
  <div class="container">
    <div class="cta-band">
      <div>
        <h2>Ready to hire?</h2>
        <p class="muted">Create your employer account in a couple of minutes. Hiring for several clients? <a href="/consultant">See the Third Party Consultant account</a> — <%= PRICE_CON %> + GST per posting.</p>
      </div>
      <div class="cta-band__actions">
        <a class="kds-btn kds-btn--brand" href="/signup/employer">Create employer account</a>
        <a class="kds-btn kds-btn--ghost" href="/contact">Talk to us</a>
      </div>
    </div>
  </div>
</section>
