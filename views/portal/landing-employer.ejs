<% extraCss.push('/css/landing.css') %>
<%
// Pricing copy is computed from lib/constants (the contract source), never from route locals: employers $14.99, consultants $9.99, + 5% GST.
const _gst = (c) => Math.round(c * C.PRICING.gst_rate), _d = (c) => '$' + (c / 100).toFixed(2);
const EMP = C.priceCentsFor('employer'), CON = C.priceCentsFor('consultant');
const PRICE_EMP = _d(EMP), TOTAL_EMP = _d(EMP + _gst(EMP)), PRICE_CON = _d(CON), TOTAL_CON = _d(CON + _gst(CON));
%>
<header class="page-head landing-head">
  <div class="container page-head__inner">
    <div>
      <p class="eyebrow">For employers</p>
      <h1>Meet the young talent building Canada's next workforce</h1>
      <p class="lead">Post once and reach students, co-op and internship candidates, new graduates, early-career hires and skilled young professionals — live in seconds, cancel any time.</p>
      <ol class="hire-route" aria-label="How hiring works here">
        <li>Post</li><li>Reach</li><li>Review</li><li class="is-active">Hire</li>
      </ol>
      <div class="page-head__actions landing-head__cta">
        <a class="kds-btn kds-btn--accent" href="/signup/employer">Post a job</a>
        <a class="kds-btn kds-btn--ghost" href="/login?role=employer">Employer sign in</a>
      </div>
    </div>
  </div>
</header>

<div class="landing-facts-band">
  <ul class="landing-facts container">
    <li><strong><%= PRICE_EMP %></strong><span>+ GST, per posting monthly</span></li>
    <li><strong>Seconds</strong><span>to go live after checkout</span></li>
    <li><strong>Monthly</strong><span>renewal, no contracts</span></li>
    <li><strong>Any time</strong><span>pause or cancel</span></li>
  </ul>
</div>

<section class="section" id="hiring-flow">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">The hiring flow</p>
      <h2>From blank form to a hire, in four moves</h2>
    </div>
    <ol class="workflow-chain workflow-chain--4">
      <li class="workflow-chain__step"><h3>Post</h3><p>Sign up, add your logo, and fill in a title, every work location, pay, languages and who it's aimed at. Nothing has to be finished in one sitting — drafts save themselves, and it goes live for <%= PRICE_EMP %> + GST.</p></li>
      <li class="workflow-chain__step"><h3>Reach</h3><p>Postings aimed at students, co-ops, new grads and early-career candidates rank ahead of senior roles by default — and still show up in every search and filter regardless of stage.</p></li>
      <li class="workflow-chain__step"><h3>Review</h3><p>See every applicant as they come in, download resumes and shortlist candidates. Applicants are notified automatically as their status changes.</p></li>
      <li class="workflow-chain__step"><h3>Hire</h3><p>Mark the hire, then pause, duplicate or repost within the paid month. The posting renews at <%= TOTAL_EMP %> a month at that same locked-in rate until you say stop.</p></li>
    </ol>
  </div>
</section>

<%- include('partials/landing-audiences', { mode: 'employer' }) %>

<section class="section section--alt" id="posting">
  <div class="container">
    <div class="proof-split">
      <div class="proof-split__statement">
        <p class="eyebrow">What every posting needs</p>
        <h2>Complete, transparent postings job seekers can trust</h2>
      </div>
      <ul class="proof-split__points">
        <li><h3>Where the job actually is</h3><p>Not a city name — the real street, unit, postal code, the works. Hiring across more than one site? List them all on the same posting so nobody applies to the wrong location.</p></li>
        <li><h3>The name people actually know</h3><p>Whatever you're branded as day-to-day (say, "Flying Pig") leads the posting and your company page, with the registered legal entity noted underneath it — not the other way around.</p></li>
        <li><h3>Money and expectations, spelled out</h3><p>Pay and how often it lands (hourly through annual), the education and experience bar from standard Job Bank lists, an industry tag and an optional NOC code — all of it fits on one printable sheet.</p></li>
      </ul>
    </div>
  </div>
</section>

<%- include('partials/landing-pricing', { signupHref: '/signup/employer', audienceLabel: 'employer', priceCents: EMP, otherLabel: 'Third Party Consultants', otherCents: CON }) %>

<%- include('partials/landing-faq', { items: faq, audienceLabel: 'employers' }) %>

<section class="section section--alt">
  <div class="container">
    <div class="cta-band">
      <div>
        <h2>Ready to hire?</h2>
        <p class="muted">Create your employer account in a couple of minutes. Hiring for several clients? <a href="/consultant">See the Third Party Consultant account</a> — <%= PRICE_CON %> + GST per posting.</p>
      </div>
      <div class="cta-band__actions">
        <a class="kds-btn kds-btn--brand" href="/signup/employer">Create employer account</a>
        <a class="kds-btn kds-btn--ghost" href="/contact">Talk to us</a>
      </div>
    </div>
  </div>
</section>
