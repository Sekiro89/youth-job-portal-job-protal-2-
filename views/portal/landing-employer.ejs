<section class="landing-hero">
  <div class="container landing-hero__inner">
    <div>
      <p class="eyebrow">For employers</p>
      <h1>Post a job across Canada for $<%= (PRICE/100).toFixed(2) %> a month.</h1>
      <p class="lead">Reach professionals, new immigrants, Indigenous peoples, refugees and youth — the people who are ready to work and hard to find on the big boards. Live in seconds, cancel any time.</p>
      <div class="cluster landing-hero__cta">
        <a class="kds-btn kds-btn--accent kds-btn--lg" href="/signup/employer">Post a job</a>
        <a class="kds-btn kds-btn--ghost kds-btn--lg" href="/login?role=employer">Employer sign in</a>
      </div>
      <p class="small muted">$<%= (TOTAL/100).toFixed(2) %> with GST · renews monthly · no contracts</p>
    </div>
    <div class="landing-hero__art" aria-hidden="true">
      <div class="mock-card">
        <div class="mock-card__bar"><span></span><span></span><span></span></div>
        <div class="mock-card__title">Registered Nurse — Long-Term Care</div>
        <div class="mock-card__sub">Prairie Health Group · Saskatoon, SK</div>
        <div class="cluster"><span class="aud aud--professionals">Professionals</span><span class="aud aud--new_immigrants">New Immigrants</span></div>
        <div class="mock-card__foot"><span class="badge badge--positive">Active</span><span>18 applicants</span></div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/landing-audiences') %>

<section class="landing-section">
  <div class="container">
    <p class="eyebrow">How it works</p>
    <h2>Three steps. Ten minutes.</h2>
    <ol class="steps">
      <li class="step"><span class="step__n">1</span><h3>Create your account</h3><p>Sign up with your company name and a contact. Add a logo and a short description so job seekers know who you are.</p></li>
      <li class="step"><span class="step__n">2</span><h3>Write the posting</h3><p>Title, location, pay, languages, the audiences it suits and how to apply. Save a draft for free and come back to it any time.</p></li>
      <li class="step"><span class="step__n">3</span><h3>Pay $<%= (PRICE/100).toFixed(2) %> + GST and go live</h3><p>Your posting is live instantly and renews every month for $<%= (TOTAL/100).toFixed(2) %>. Applicants land in your dashboard. Cancel with one click when the role is filled.</p></li>
    </ol>
  </div>
</section>

<%- include('partials/landing-pricing', { signupHref: '/signup/employer', audienceLabel: 'employer' }) %>

<section class="landing-section">
  <div class="container">
    <p class="eyebrow">Your dashboard</p>
    <h2>Everything about hiring in one place</h2>
    <div class="grid grid--3">
      <div class="card"><h3>Applicant tracking</h3><p class="muted">See every applicant, download resumes, shortlist and mark hires. Candidates are notified automatically as their status changes.</p></div>
      <div class="card"><h3>Pause, duplicate, repost</h3><p class="muted">Pause when you have enough applicants, duplicate a posting for a similar role, reactivate any time within the paid month.</p></div>
      <div class="card"><h3>Billing you can hand to accounting</h3><p class="muted">Every charge has a numbered GST receipt. See all subscriptions and payments under Billing.</p></div>
    </div>
    <p class="cluster landing-cta-row"><a class="kds-btn kds-btn--brand" href="/signup/employer">Create an employer account</a> <span class="muted">Hiring for several clients? <a href="/consultant">See the consultant account</a>.</span></p>
  </div>
</section>

<%- include('partials/landing-faq') %>
