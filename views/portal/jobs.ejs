<% const qs = (o) => { const p = new URLSearchParams(); Object.entries(o).forEach(([k, v]) => { if (v) p.set(k, v); }); const s = p.toString(); return base + '/jobs' + (s ? '?' + s : ''); }; %>
<div class="container dash">
  <%- include('partials/side') %>
  <div class="dash__main">
    <header class="app-head">
      <div>
        <p class="eyebrow">Postings</p>
        <h1>Jobs</h1>
        <p class="app-head__context"><span><%= counts.all %> posting<%= counts.all === 1 ? '' : 's' %> · <%= counts.active %> active</span></p>
      </div>
      <div class="app-head__actions"><a class="kds-btn kds-btn--accent" href="<%= base %>/jobs/new<%= profileId ? '?profile=' + profileId : '' %>">Post a job</a></div>
    </header>

    <%- include('partials/company-picker', { selected: profileId, hrefFor: (id) => qs({ status, profile: id }) }) %>

    <section class="card card--table" aria-labelledby="jobs-title">
      <h2 id="jobs-title" class="visually-hidden">Postings by status</h2>
      <div class="tabs" role="tablist" aria-label="Filter by status">
        <% Object.entries(TABS).forEach(([k, label]) => { %>
          <a class="tab <%= status === k ? 'is-active' : '' %>" href="<%= qs({ status: k === 'all' ? '' : k, profile: profileId }) %>"<%- status === k ? ' aria-current="page"' : '' %>><%= label %> <span class="tab__count"><%= counts[k] %></span></a>
        <% }) %>
      </div>

      <% if (!list.length) { %>
        <div class="empty">
          <% if (status === 'all') { %>No postings yet. <a href="<%= base %>/jobs/new">Post your first job</a>.<% } else { %>Nothing under “<%= TABS[status] %>”.<% } %>
        </div>
      <% } else { %>
      <div class="table-wrap">
        <table class="table table--stack">
          <thead><tr><th>Posting ID</th><th>Title</th><% if (isConsultant) { %><th>Company</th><% } %><th>Status</th><th>Applicants</th><th>Renews / ended</th><th>Actions</th></tr></thead>
          <tbody>
            <% list.forEach(job => { const closed = typeof job.applications_closed !== 'undefined' ? !!job.applications_closed : false; %>
              <tr>
                <td data-label="Posting ID"><% if (job.public_id) { %><span class="posting-id__code"><%= job.public_id %></span><% } else { %><span class="muted">—</span><% } %></td>
                <td data-label="Title" class="td-stack"><a href="<%= base %>/jobs/<%= job.id %>"><strong><%= job.title %></strong></a><div class="small muted job-meta-line"><span><%= h.location(job) || 'No location' %><%= job.n_locations > 1 ? ' +' + (job.n_locations - 1) + ' more' : '' %></span><% if (h.formatHours(job)) { %><span>· <%= h.formatHours(job) %></span><% } %><span>· <%= job.views %> views</span><span>· <%= job.published_at ? 'Posted ' + h.formatDate(job.published_at) : 'Not published' %></span></div></td>
                <% if (isConsultant) { %><td data-label="Company"><%= h.displayCompany(job) %></td><% } %>
                <td data-label="Status"><span class="cluster cluster--tight"><%- include('partials/status-badge', { job }) %><% if (closed) { %><span class="badge badge--danger">Applications closed</span><% } else if (job.application_deadline) { %><span class="badge">Closes <%= h.formatDate(job.application_deadline) %></span><% } %></span></td>
                <td data-label="Applicants"><a href="<%= base %>/jobs/<%= job.id %>/applicants"><%= job.applicants %></a></td>
                <td data-label="Renews / ended">
                  <% if (job.status === 'active') { %><%= job.cancel_at_period_end ? 'Ends ' : 'Renews ' %><%= h.formatDate(job.expires_at) %>
                  <% } else if (job.status === 'inactive' && job.sub_status === 'active') { %>Paused · paid until <%= h.formatDate(job.current_period_end) %>
                  <% } else if (job.status === 'inactive') { %>Paused <%= h.formatDate(job.archived_at) %>
                  <% } else if (job.status === 'pending_payment') { %><a href="/billing/checkout/<%= job.id %>">Pay $<%= (TOTAL/100).toFixed(2) %></a>
                  <% } else if (job.status === 'cancelled') { %>Cancelled <%= h.formatDate(job.cancelled_at || job.archived_at) %>
                  <% } else if (job.status === 'expired') { %>Expired <%= h.formatDate(job.archived_at || job.expires_at) %>
                  <% } else { %>—<% } %>
                </td>
                <td data-label="Actions">
                  <div class="td-actions">
                    <a class="kds-btn kds-btn--ghost kds-btn--sm" href="<%= base %>/jobs/<%= job.id %>">View</a>
                    <a class="kds-btn kds-btn--ghost kds-btn--sm" href="<%= base %>/jobs/<%= job.id %>/edit">Edit</a>
                    <% if (['draft','pending_payment'].includes(job.status)) { %><form class="inline-form" method="post" action="<%= base %>/jobs/<%= job.id %>/publish"><button class="kds-btn kds-btn--brand kds-btn--sm" type="submit"><%= job.status === 'draft' ? 'Publish' : 'Pay now' %></button></form><% } %>
                    <% if (['expired','cancelled'].includes(job.status)) { %><form class="inline-form" method="post" action="<%= base %>/jobs/<%= job.id %>/duplicate"><button class="kds-btn kds-btn--ghost kds-btn--sm" type="submit">Repost</button></form><% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
      <p class="card__foot small muted">Archived = expired, cancelled or paused postings; job seekers never see them. Paused postings can be reactivated while paid up. Use <strong>Repost</strong> to publish an expired or cancelled one again as a new draft.</p>
    </section>
  </div>
</div>
