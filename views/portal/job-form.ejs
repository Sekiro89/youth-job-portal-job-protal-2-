<% const v = values; const err = (k) => errors[k] ? `<div class="error" id="err-${k}">${h.escapeHtml(errors[k])}</div>` : ''; const inv = (k) => errors[k] ? ` aria-invalid="true" aria-describedby="err-${k}"` : '';
   const isEdit = !!job; const canPublish = !job || ['draft','pending_payment'].includes(job.status); const isLive = job && job.status === 'active';
   const locked = isEdit && ['active','pending_payment'].includes(job.status);
   const selPid = v.employer_profile_id ? String(v.employer_profile_id) : '';
   const renderProfiles = isConsultant ? profiles : profiles.slice(0, 1);
   const chosenIds = (v.location_ids || []).map(String); const keptIds = (v.keep_job_locations || []).map(String);
   const legacy = typeof legacyLocs !== 'undefined' ? legacyLocs : [];
   const nl = v.new_loc || {};
   const newOpen = !!(nl.street_address || nl.city || nl.postal_code || nl.label || Object.keys(errors).some(k => k.startsWith('new_loc_')));
   const profileHref = isConsultant ? (selPid ? '/consultant/profiles/' + selPid + '/edit#locations' : '/consultant/profiles') : '/employer/profile#locations'; %>
<div class="container dash">
  <%- include('partials/side') %>
  <div class="dash__main">
    <div class="split">
      <div>
        <p class="eyebrow"><%= isEdit ? 'Edit posting' : 'New posting' %></p>
        <h1><%= isEdit ? job.title : 'Post a job' %></h1>
        <% if (isEdit) { %><p class="muted"><%- include('partials/status-badge', { job }) %> <% if (isLive) { %>Changes to a live posting are published immediately.<% } %></p>
        <% } else { %><p class="muted">Save as a draft for free. Publishing costs $<%= (PRICE/100).toFixed(2) %> + GST (<strong>$<%= (TOTAL/100).toFixed(2) %>/month</strong>), renews monthly, cancel any time.</p><% } %>
      </div>
      <% if (isEdit) { %><a class="kds-btn kds-btn--ghost" href="<%= base %>/jobs/<%= job.id %>">Back to posting</a><% } %>
    </div>

    <% if (Object.keys(errors).length) { %><div class="flash flash--error" role="alert">Please fix the <%= Object.keys(errors).length %> highlighted field<%= Object.keys(errors).length === 1 ? '' : 's' %> below.</div><% } %>

    <form class="form job-form" method="post" action="<%= isEdit ? base + '/jobs/' + job.id + '/edit' : base + '/jobs/new' %>" novalidate>
      <section class="card form-section">
        <h2 class="form-section__title"><%= isConsultant ? 'Post as company' : 'Company' %></h2>
        <% if (isConsultant) { %>
        <div class="field">
          <label for="employer_profile_id">Which client is this posting for? <span class="req">*</span></label>
          <select class="input" id="employer_profile_id" name="employer_profile_id" required<%- inv('employer_profile_id') %><%= locked ? ' disabled' : '' %>>
            <option value="" data-contact-email="">Choose a company…</option>
            <% profiles.forEach(p => { %><option value="<%= p.id %>" data-contact-email="<%= p.contact_email || user.email %>" <%= selPid === String(p.id) ? 'selected' : '' %>><%= h.displayCompany(p) %><%= h.legalNameNote(p) ? ' (' + p.company_name + ')' : '' %><%= p.city ? ' — ' + h.location(p) : '' %></option><% }) %>
          </select>
          <% if (locked) { %><input type="hidden" name="employer_profile_id" value="<%= job.employer_profile_id %>"><div class="hint">The company cannot change once billing has started.</div><% } else { %><div class="hint">Not listed? <a href="/consultant/profiles/new?then=post">Add a company</a>.</div><% } %>
          <%- err('employer_profile_id') %>
        </div>
        <% } else { %><input type="hidden" name="employer_profile_id" value="<%= v.employer_profile_id %>"><%- errors.employer_profile_id ? '<div class="flash flash--error">' + h.escapeHtml(errors.employer_profile_id) + ' <a href="/employer/profile">Company profile</a></div>' : '' %><% } %>
        <% renderProfiles.forEach(p => { const names = p.operating_names && p.operating_names.length ? p.operating_names : (p.operating_name ? [p.operating_name] : []); const isSel = selPid === String(p.id);
             const choice = isSel ? (v.operating_name_choice || '__legal') : (p.operating_name || '__legal'); const custom = choice !== '__legal' && choice !== '__new' && !names.includes(choice); %>
        <div class="field" data-profile="<%= p.id %>"<%= isConsultant && !isSel ? ' hidden' : '' %>>
          <label for="opname-<%= p.id %>">Operating name for this posting</label>
          <select class="input" id="opname-<%= p.id %>" name="operating_name_choice_<%= p.id %>" data-select-toggles="opname-new-<%= p.id %>" data-toggle-value="__new"<%- isSel ? inv('operating_name') : '' %>>
            <option value="__legal" <%= choice === '__legal' ? 'selected' : '' %>>Legal name — <%= p.company_name %></option>
            <% names.forEach((n, i) => { %><option value="<%= n %>" <%= choice === n ? 'selected' : '' %>><%= n %><%= i === 0 ? ' (default)' : '' %></option><% }) %>
            <% if (custom) { %><option value="<%= choice %>" selected><%= choice %> (current)</option><% } %>
            <option value="__new" <%= choice === '__new' ? 'selected' : '' %>>Add a new operating name…</option>
          </select>
          <div class="hint">Job seekers see this name first; the legal name appears underneath. <a href="<%= isConsultant ? '/consultant/profiles/' + p.id + '/edit#operating-names' : '/employer/profile#operating-names' %>">Manage names</a></div>
          <%- isSel ? err('operating_name') : '' %>
          <div class="field field--sub" id="opname-new-<%= p.id %>" data-nojs-visible>
            <label for="opname-new-input-<%= p.id %>">New operating name</label>
            <input class="input" id="opname-new-input-<%= p.id %>" name="operating_name_new_<%= p.id %>" value="<%= isSel ? (v.operating_name_new || '') : '' %>" maxlength="120" placeholder="e.g. Flying Pig">
            <div class="hint">Saved to the company profile so you can pick it next time.</div>
          </div>
        </div>
        <% }) %>
      </section>

      <section class="card form-section">
        <h2 class="form-section__title">The role</h2>
        <div class="field">
          <label for="title">Job title <span class="req">*</span></label>
          <input class="input" id="title" name="title" value="<%= v.title %>" maxlength="120" required placeholder="e.g. Registered Nurse — Long-Term Care"<%- inv('title') %>>
          <%- err('title') %>
        </div>
        <div class="form-row form-row--3">
          <div class="field">
            <label for="category">Category <span class="req">*</span></label>
            <select class="input" id="category" name="category" required<%- inv('category') %>>
              <option value="">Choose…</option>
              <% C.CATEGORIES.forEach(([k, n]) => { %><option value="<%= k %>" <%= v.category === k ? 'selected' : '' %>><%= n %></option><% }) %>
            </select>
            <%- err('category') %>
          </div>
          <div class="field">
            <label for="job_type">Job type <span class="req">*</span></label>
            <select class="input" id="job_type" name="job_type"<%- inv('job_type') %>>
              <% C.JOB_TYPES.forEach(([k, n]) => { %><option value="<%= k %>" <%= v.job_type === k ? 'selected' : '' %>><%= n %></option><% }) %>
            </select>
            <%- err('job_type') %>
          </div>
          <div class="field">
            <label for="work_arrangement">Work arrangement <span class="req">*</span></label>
            <select class="input" id="work_arrangement" name="work_arrangement"<%- inv('work_arrangement') %>>
              <% C.WORK_ARRANGEMENTS.forEach(([k, n]) => { %><option value="<%= k %>" <%= v.work_arrangement === k ? 'selected' : '' %>><%= n %></option><% }) %>
            </select>
            <%- err('work_arrangement') %>
          </div>
        </div>
        <div class="form-row form-row--3">
          <div class="field">
            <label for="experience_level">Experience</label>
            <select class="input" id="experience_level" name="experience_level" data-select-toggles="experience_other_wrap" data-toggle-value="other"<%- inv('experience_level') %>>
              <option value="">Any</option>
              <% C.EXPERIENCE_LEVELS.forEach(([k, n]) => { %><option value="<%= k %>" <%= v.experience_level === k ? 'selected' : '' %>><%= n %></option><% }) %>
            </select>
            <%- err('experience_level') %>
            <div class="field field--sub" id="experience_other_wrap" data-nojs-visible>
              <label for="experience_other">Other experience <span class="muted">(if “Other”)</span></label>
              <input class="input" id="experience_other" name="experience_other" value="<%= v.experience_other || '' %>" maxlength="120" placeholder="e.g. 3 seasons of tree planting"<%- inv('experience_other') %>>
              <%- err('experience_other') %>
            </div>
          </div>
          <div class="field">
            <label for="education">Education</label>
            <select class="input" id="education" name="education" data-select-toggles="education_other_wrap" data-toggle-value="other"<%- inv('education') %>>
              <option value="">Not specified</option>
              <% C.EDUCATION_LEVELS.forEach(([k, n]) => { %><option value="<%= k %>" <%= v.education === k ? 'selected' : '' %>><%= n %></option><% }) %>
            </select>
            <%- err('education') %>
            <div class="field field--sub" id="education_other_wrap" data-nojs-visible>
              <label for="education_other">Other education <span class="muted">(if “Other”)</span></label>
              <input class="input" id="education_other" name="education_other" value="<%= v.education_other || '' %>" maxlength="160" placeholder="e.g. Red Seal welding ticket"<%- inv('education_other') %>>
              <%- err('education_other') %>
            </div>
          </div>
          <div class="field">
            <label for="noc_code">NOC code <span class="muted">(optional)</span></label>
            <input class="input" id="noc_code" name="noc_code" value="<%= v.noc_code %>" inputmode="numeric" maxlength="5" placeholder="e.g. 31301"<%- inv('noc_code') %>>
            <div class="hint">2021 National Occupational Classification — helps LMIA and immigration-focused seekers.</div>
            <%- err('noc_code') %>
          </div>
        </div>
      </section>

      <section class="card form-section" id="locations" aria-labelledby="locations-title">
        <h2 class="form-section__title" id="locations-title">Work location(s) <span class="req">*</span></h2>
        <p class="hint hint--lead">Tick every address where the person will work — each one is printed on the posting and shown on the map. Locations come from the company profile (<a href="<%= profileHref %>">manage locations</a>).</p>
        <%- errors.locations ? `<div class="error error--block" id="err-locations" role="alert">${h.escapeHtml(errors.locations)}</div>` : '' %>
        <% if (isConsultant) { %><p class="hint" data-profile-none<%= selPid ? ' hidden' : '' %>>Choose a company above to see its locations.</p><% } %>
        <% renderProfiles.forEach(p => { const list = byProfile[p.id] || []; const isSel = selPid === String(p.id); %>
        <div class="loc-choice" data-profile="<%= p.id %>"<%= isConsultant && selPid && !isSel ? ' hidden' : '' %>>
          <% if (isConsultant) { %><div class="small muted" data-nojs-only>Locations of <%= h.displayCompany(p) %></div><% } %>
          <% if (!list.length) { %><div class="empty empty--sm">No saved locations for <%= h.displayCompany(p) %> yet — add one below and it is saved to the profile.</div>
          <% } else { %>
          <div class="checks checks--loc">
            <% list.forEach(l => { %>
            <label class="check check--loc"><input type="checkbox" name="location_ids" value="<%= l.id %>" <%= isSel && chosenIds.includes(String(l.id)) ? 'checked' : '' %>><span class="check__body"><span class="check__title"><%= l.label || 'Location' %><% if (l.is_default) { %> <span class="badge badge--positive">Default</span><% } %></span><span class="check__sub"><%= h.fullAddress(l) %></span></span></label>
            <% }) %>
          </div>
          <% } %>
        </div>
        <% }) %>
        <% if (legacy.length) { %>
        <div class="loc-choice loc-choice--legacy">
          <div class="small muted">Saved on this posting (not in the company’s location list)</div>
          <div class="checks checks--loc">
            <% legacy.forEach(l => { %>
            <label class="check check--loc"><input type="checkbox" name="keep_job_locations" value="<%= l.id %>" <%= keptIds.includes(String(l.id)) ? 'checked' : '' %>><span class="check__body"><span class="check__title">Keep this address</span><span class="check__sub"><%= l.street_address ? h.fullAddress(l) : h.location(l) %></span></span></label>
            <% }) %>
          </div>
        </div>
        <% } %>
        <details class="loc-new" id="loc-new"<%= newOpen ? ' open' : '' %>>
          <summary class="loc-new__summary">+ Add a new location</summary>
          <p class="hint">Saved to the company profile and selected for this posting. Leave it empty if the job is at the locations ticked above.</p>
          <%- include('partials/location-fields', { prefix: 'new_loc_', vals: nl, errs: errors, idp: 'new-loc-', showLabel: true }) %>
          <button class="kds-btn kds-btn--ghost kds-btn--sm" type="button" data-nojs-hide id="loc-new-clear">Clear</button>
        </details>
      </section>

      <section class="card form-section">
        <h2 class="form-section__title">Pay &amp; hours</h2>
        <div class="form-row form-row--3">
          <div class="field">
            <label for="salary_min">Pay from (CAD)</label>
            <input class="input" id="salary_min" name="salary_min" value="<%= v.salary_min %>" inputmode="numeric" placeholder="e.g. 52000"<%- inv('salary_min') %>>
            <%- err('salary_min') %>
          </div>
          <div class="field">
            <label for="salary_max">Pay to (CAD)</label>
            <input class="input" id="salary_max" name="salary_max" value="<%= v.salary_max %>" inputmode="numeric" placeholder="e.g. 60000"<%- inv('salary_max') %>>
            <%- err('salary_max') %>
          </div>
          <div class="field">
            <label for="salary_period">Pay period</label>
            <select class="input" id="salary_period" name="salary_period">
              <% C.SALARY_PERIODS.forEach(([k, n]) => { %><option value="<%= k %>" <%= (v.salary_period || 'year') === k ? 'selected' : '' %>><%= n.replace(/^per /, 'Per ').replace(/^bi-weekly$/, 'Bi-weekly') %></option><% }) %>
            </select>
            <div class="hint">Shown as e.g. “$52,000 – $60,000/year” or “$22/hour”.</div>
          </div>
        </div>
        <div class="form-row form-row--3">
          <div class="field">
            <label for="hours_amount">Number of hours worked <span class="muted">(optional)</span></label>
            <input class="input" id="hours_amount" name="hours_amount" type="number" inputmode="decimal" min="0.5" max="168" step="0.5" value="<%= v.hours_amount %>" placeholder="e.g. 35"<%- inv('hours_amount') %>>
            <%- err('hours_amount') %>
          </div>
          <div class="field">
            <label for="hours_period">Hours frequency</label>
            <select class="input" id="hours_period" name="hours_period">
              <% C.HOURS_PERIODS.forEach(([k, n]) => { %><option value="<%= k %>" <%= (v.hours_period || 'week') === k ? 'selected' : '' %>><%= n.replace(/^per /, 'Per ').replace(/^bi-weekly$/, 'Bi-weekly') %></option><% }) %>
            </select>
            <div class="hint">Shown as e.g. “35 hours per week”.</div>
          </div>
          <div class="field">
            <label for="vacancies">Number of positions <span class="req">*</span></label>
            <input class="input" id="vacancies" name="vacancies" type="number" min="1" max="999" value="<%= v.vacancies %>" required<%- inv('vacancies') %>>
            <%- err('vacancies') %>
          </div>
        </div>
        <div class="field">
          <label for="skills">Key skills <span class="muted">(comma-separated)</span></label>
          <input class="input" id="skills" name="skills" value="<%= v.skills %>" maxlength="600" placeholder="e.g. Forklift licence, Customer service, Excel">
          <div class="hint">Used for matching job seekers to your posting.</div>
        </div>
        <fieldset class="field fieldset">
          <legend>Languages <span class="req">*</span></legend>
          <div class="checks checks--3">
            <% ['English', 'French', 'Other'].forEach(l => { %>
              <label class="check"><input type="checkbox" name="languages" value="<%= l %>" <%= (v.languages || []).includes(l) ? 'checked' : '' %> <%= l === 'Other' ? 'data-toggles="language_other_wrap"' : '' %>> <%= l %></label>
            <% }) %>
          </div>
          <div class="field" id="language_other_wrap" <%= (v.languages || []).includes('Other') ? '' : 'hidden' %>>
            <label for="language_other">Other language(s)</label>
            <input class="input" id="language_other" name="language_other" value="<%= v.language_other %>" maxlength="120" placeholder="e.g. Punjabi, Mandarin"<%- inv('language_other') %>>
            <%- err('language_other') %>
          </div>
          <%- err('languages') %>
        </fieldset>
        <fieldset class="field fieldset">
          <legend>Who is this role a great fit for? <span class="muted">(shown as tags on the posting)</span></legend>
          <div class="checks checks--3 checks--aud">
            <% C.AUDIENCES.forEach(([k, n]) => { %>
              <label class="check check--aud aud--<%= k %>"><input type="checkbox" name="audiences" value="<%= k %>" <%= (v.audiences || []).includes(k) ? 'checked' : '' %>> <span class="aud aud--<%= k %>"><%= n %></span></label>
            <% }) %>
          </div>
        </fieldset>
      </section>

      <section class="card form-section">
        <h2 class="form-section__title">Description</h2>
        <div class="field">
          <label for="description">Job description <span class="req">*</span></label>
          <textarea class="input" id="description" name="description" rows="10" minlength="100" maxlength="12000" required data-counter="desc-count" placeholder="What the person will do, the team, the shifts, why it is a great place to work…"<%- inv('description') %>><%= v.description %></textarea>
          <div class="hint"><span id="desc-count"><%= (v.description || '').length %></span> / 12,000 characters · minimum 100. Blank lines start new paragraphs; lines starting with “-” read as bullet points.</div>
          <%- err('description') %>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="requirements">Requirements</label>
            <textarea class="input" id="requirements" name="requirements" rows="6" maxlength="6000" placeholder="Licences, certifications, work authorization, experience…"><%= v.requirements %></textarea>
          </div>
          <div class="field">
            <label for="benefits">Benefits</label>
            <textarea class="input" id="benefits" name="benefits" rows="6" maxlength="6000" placeholder="Health and dental, training, relocation support, transit…"><%= v.benefits %></textarea>
          </div>
        </div>
      </section>

      <section class="card form-section">
        <h2 class="form-section__title">How to apply</h2>
        <p class="muted small">Applicants always apply through Canada Careers (resume + cover sheet into your dashboard). Add an email or link if you also want applications routed elsewhere.</p>
        <div class="form-row">
          <div class="field">
            <label for="apply_email">Application email (the employer’s inbox)</label>
            <input class="input" id="apply_email" name="apply_email" type="email" value="<%= v.apply_email %>" maxlength="160" autocomplete="off" data-apply-default="<%= v.apply_email %>"<%- inv('apply_email') %>>
            <div class="hint">Applicants also land in your dashboard.</div>
            <%- err('apply_email') %>
          </div>
          <div class="field">
            <label for="apply_url">External application link</label>
            <input class="input" id="apply_url" name="apply_url" value="<%= v.apply_url %>" maxlength="300" placeholder="https://…"<%- inv('apply_url') %>>
            <%- err('apply_url') %>
          </div>
        </div>
      </section>

      <div class="form-actions form-actions--sticky">
        <button class="kds-btn kds-btn--ghost" type="submit" name="action" value="draft"><%= isEdit ? (isLive ? 'Save changes' : 'Save') : 'Save draft' %></button>
        <% if (canPublish) { %><button class="kds-btn kds-btn--accent" type="submit" name="action" value="publish"><span class="lbl-long"><%= isEdit && job.status === 'pending_payment' ? 'Save & pay now' : 'Save & continue to payment' %></span><span class="lbl-short"><%= isEdit && job.status === 'pending_payment' ? 'Pay now' : 'Publish' %></span> · $<%= (TOTAL/100).toFixed(2) %>/mo</button><% } %>
        <% if (isEdit) { %><a class="kds-btn kds-btn--ghost" href="<%= base %>/jobs/<%= job.id %>">Cancel</a><% } else { %><a class="kds-btn kds-btn--ghost" href="<%= base %>/jobs">Cancel</a><% } %>
      </div>
    </form>
  </div>
</div>
