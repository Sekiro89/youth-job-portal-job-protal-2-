<% extraCss.push('/css/landing.css') %>
<%
// Pricing copy is computed from lib/constants (the contract source), never from route locals: employers $14.99, consultants $9.99, + 5% GST.
const _gst = (c) => Math.round(c * C.PRICING.gst_rate), _d = (c) => '$' + (c / 100).toFixed(2);
const EMP = C.priceCentsFor('employer'), CON = C.priceCentsFor('consultant');
const PRICE_EMP = _d(EMP), TOTAL_EMP = _d(EMP + _gst(EMP)), PRICE_CON = _d(CON), TOTAL_CON = _d(CON + _gst(CON));
%>
<header class="page-head landing-head">
  <div class="container page-head__inner">
    <div>
      <p class="eyebrow">For Third Party Consultants</p>
      <h1>One login. Every client's next hire.</h1>
      <p class="lead">Recruiters, staffing agencies, HR and immigration consultants: add unlimited employer profiles, post on behalf of any of them, and put every client in front of Canada's next generation of talent from one dashboard.</p>
      <div class="page-head__actions landing-head__cta">
        <a class="kds-btn kds-btn--accent" href="/signup/consultant">Create consultant account</a>
        <a class="kds-btn kds-btn--ghost" href="/login?role=consultant">Consultant sign in</a>
      </div>
    </div>
  </div>
</header>

<div class="landing-facts-band">
  <ul class="landing-facts container">
    <li><strong><%= PRICE_CON %></strong><span>+ GST, per posting monthly</span></li>
    <li><strong>Unlimited</strong><span>client profiles, one login</span></li>
    <li><strong>$0</strong><span>per-client fees or minimums</span></li>
    <li><strong>Any time</strong><span>cancel any posting</span></li>
  </ul>
</div>

<section class="section" id="agencies">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Built for agencies</p>
      <h2>Everything you manage, from one place</h2>
    </div>
    <div class="partner-hub" aria-label="Diagram: your partner account branches into clients, and every client's work branches into postings and billing">
      <div class="partner-hub__root">
        <h3>Partner account</h3>
        <p>One login for your whole practice — created once, used for every client you take on.</p>
      </div>
      <div class="partner-hub__trunk" aria-hidden="true"></div>
      <ul class="partner-hub__row partner-hub__row--clients">
        <li class="partner-hub__node partner-hub__node--chip">Client A</li>
        <li class="partner-hub__node partner-hub__node--chip">Client B</li>
        <li class="partner-hub__node partner-hub__node--chip">Client C</li>
      </ul>
      <div class="partner-hub__caption">
        <h3>Clients</h3>
        <p>Add every client as its own company profile — name, logo, location, description. Job seekers see the client as the employer, not you.</p>
      </div>
      <div class="partner-hub__trunk" aria-hidden="true"></div>
      <ul class="partner-hub__row partner-hub__row--outcomes">
        <li class="partner-hub__node partner-hub__node--card">
          <h3>Postings</h3>
          <p>The posting form asks "Post as company." Switch between clients with one click on every jobs list and dashboard.</p>
        </li>
        <li class="partner-hub__node partner-hub__node--card">
          <h3>Billing</h3>
          <p>Every subscription and receipt, grouped by client, one place to look — download any of them as a PDF when it's time to bill a client back.</p>
        </li>
      </ul>
    </div>
  </div>
</section>

<section class="section section--alt" id="switch">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">One login, every client</p>
      <h2>Switch clients without switching accounts</h2>
      <p class="lead">Every client gets their own profile under your one login — pick who you're posting for and everything after that (postings, applicants, billing) is scoped to them.</p>
    </div>
    <div class="client-switch" role="group" aria-label="Example client switcher">
      <p class="client-switch__account">Your partner account</p>
      <div class="client-switch__tabs">
        <button type="button" class="client-switch__tab is-active" aria-pressed="true">Client A</button>
        <button type="button" class="client-switch__tab" aria-pressed="false">Client B</button>
        <button type="button" class="client-switch__tab" aria-pressed="false">Client C</button>
      </div>
      <p class="client-switch__note small muted">Illustrative — the same "post as company" switch already in your dashboard.</p>
    </div>
  </div>
</section>

<%- include('partials/landing-audiences', { mode: 'network', stack: true }) %>

<section class="section" id="how-it-works">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">How it works</p>
      <h2>Three steps per client</h2>
    </div>
    <ol class="proc-flow">
      <li class="proc-flow__step"><span class="proc-flow__n">01</span><h3>Create account</h3><p>One login for your whole practice. Then add each client under Companies — it takes a minute per client.</p></li>
      <li class="proc-flow__step"><span class="proc-flow__n">02</span><h3>Add client</h3><p>Each client gets its own company profile — name, logo, location. Candidates see the client as the employer, not you.</p></li>
      <li class="proc-flow__step"><span class="proc-flow__n">03</span><h3>Post for client</h3><p>Choose the client, note where the role is based and who it's aimed at, then check out at <%= PRICE_CON %> + GST — renewing at <%= TOTAL_CON %> a month until you cancel.</p></li>
    </ol>
  </div>
</section>

<%- include('partials/posting-specimen', {
  eyebrow: 'What every posting needs',
  heading: 'Your client, not your agency, leads every posting',
  lead: 'Each client profile carries the name their candidates would recognize — that leads the posting and the company page, legal name tucked beneath. Your agency stays invisible to job seekers.',
  identityLabel: 'Client identity',
  identityNote: 'Not the agency\'s own name',
}) %>

<%- include('partials/landing-pricing', { signupHref: '/signup/consultant', audienceLabel: 'consultant', priceCents: CON, otherLabel: 'Employers posting for their own company', otherCents: EMP }) %>

<%- include('partials/landing-faq', { items: faq, groups: faqGroups, audienceLabel: 'consultants', intro: 'What you need to know before you run every client\'s postings from one account.' }) %>

<section class="section section--alt">
  <div class="container">
    <div class="cta-band">
      <div>
        <h2>Ready to post for your clients?</h2>
        <p class="muted">Create your consultant account and add your first client in minutes. Hiring for your own company only? <a href="/employer">Use the Employer account</a> — <%= PRICE_EMP %> + GST per posting.</p>
      </div>
      <div class="cta-band__actions">
        <a class="kds-btn kds-btn--brand" href="/signup/consultant">Create consultant account</a>
        <a class="kds-btn kds-btn--ghost" href="/contact">Talk to us</a>
      </div>
    </div>
  </div>
</section>
