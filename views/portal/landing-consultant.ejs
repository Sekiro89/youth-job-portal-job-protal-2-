<% extraCss.push('/css/landing.css') %>
<%
// Pricing copy is computed from lib/constants (the contract source), never from route locals: employers $14.99, consultants $9.99, + 5% GST.
const _gst = (c) => Math.round(c * C.PRICING.gst_rate), _d = (c) => '$' + (c / 100).toFixed(2);
const EMP = C.priceCentsFor('employer'), CON = C.priceCentsFor('consultant');
const PRICE_EMP = _d(EMP), TOTAL_EMP = _d(EMP + _gst(EMP)), PRICE_CON = _d(CON), TOTAL_CON = _d(CON + _gst(CON));
%>
<header class="page-head landing-head">
  <div class="container page-head__inner">
    <div>
      <p class="eyebrow">For Third Party Consultants</p>
      <h1>One login. Every client's next hire.</h1>
      <p class="lead">Recruiters, staffing agencies, HR and immigration consultants: add unlimited employer profiles, post on behalf of any of them, and put every client in front of Canada's next generation of talent from one dashboard.</p>
      <div class="page-head__actions landing-head__cta">
        <a class="kds-btn kds-btn--accent" href="/signup/consultant">Create consultant account</a>
        <a class="kds-btn kds-btn--ghost" href="/login?role=consultant">Consultant sign in</a>
      </div>
    </div>
  </div>
</header>

<div class="landing-facts-band">
  <ul class="landing-facts container">
    <li><strong><%= PRICE_CON %></strong><span>+ GST, per posting monthly</span></li>
    <li><strong>Unlimited</strong><span>client profiles, one login</span></li>
    <li><strong>$0</strong><span>per-client fees or minimums</span></li>
    <li><strong>Any time</strong><span>cancel any posting</span></li>
  </ul>
</div>

<section class="section" id="agencies">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Built for agencies</p>
      <h2>One account, all your clients</h2>
    </div>
    <ul class="landing-tiles landing-tiles--3">
      <li class="landing-tile"><span class="landing-tile__n">01</span><h3>Unlimited employer profiles</h3><p>Add every client as its own company — name, logo, location, description. Job seekers see the client as the employer, not you.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">02</span><h3>Post on behalf of any client</h3><p>The posting form asks “Post as company”. Switch between clients with one click on every jobs list and dashboard.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">03</span><h3>One invoice list across clients</h3><p>Billing shows every subscription and numbered GST receipt in one place, grouped by company, and every receipt downloads as a PDF from your login — pass-through invoicing takes minutes.</p></li>
    </ul>
  </div>
</section>

<%- include('partials/landing-audiences', { mode: 'post' }) %>

<section class="section" id="how-it-works">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">How it works</p>
      <h2>Three steps per client</h2>
    </div>
    <ol class="landing-tiles landing-tiles--3">
      <li class="landing-tile"><span class="landing-tile__n">01</span><h3>Create your consultant account</h3><p>One login for your whole practice. Then add each client under Companies — it takes a minute per client.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">02</span><h3>Post as the client</h3><p>Pick the company, write the posting with its full work address (several addresses on one posting are fine), tag the audiences it suits, save a draft or publish straight away.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">03</span><h3>Pay <%= PRICE_CON %> + GST per posting</h3><p>Each posting renews monthly for <%= TOTAL_CON %> until you cancel it — the checkout price is locked in for that posting. Applicants for all clients land in one dashboard with a per-company breakdown.</p></li>
    </ol>
  </div>
</section>

<section class="section section--alt" id="posting">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">What every posting needs</p>
      <h2>Complete, transparent postings job seekers can trust</h2>
    </div>
    <ul class="landing-tiles landing-tiles--3">
      <li class="landing-tile"><span class="landing-tile__n">01</span><h3>A full work address</h3><p>Every posting carries at least one complete work location — street address, city, province and postal code. If the job is offered at several sites, add more than one address to the same posting; seekers see each one listed in full.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">02</span><h3>The client's operating name</h3><p>Each client profile carries the name job seekers know the business by (e.g. "Flying Pig") alongside its legal name. The operating name is shown first on every posting and company page — your agency's name never appears.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">03</span><h3>Clear pay and requirements</h3><p>Salary with its period (per hour, day, week, bi-weekly, month or year), education and experience picked from standard lists, an industry category and an optional NOC code — printable on one clean sheet.</p></li>
    </ul>
  </div>
</section>

<%- include('partials/landing-pricing', { signupHref: '/signup/consultant', audienceLabel: 'consultant', priceCents: CON, otherLabel: 'Employers posting for their own company', otherCents: EMP }) %>

<%- include('partials/landing-faq', { items: faq, audienceLabel: 'consultants' }) %>

<section class="section section--alt">
  <div class="container">
    <div class="cta-band">
      <div>
        <h2>Ready to post for your clients?</h2>
        <p class="muted">Create your consultant account and add your first client in minutes. Hiring for your own company only? <a href="/employer">Use the Employer account</a> — <%= PRICE_EMP %> + GST per posting.</p>
      </div>
      <div class="cta-band__actions">
        <a class="kds-btn kds-btn--brand" href="/signup/consultant">Create consultant account</a>
        <a class="kds-btn kds-btn--ghost" href="/contact">Talk to us</a>
      </div>
    </div>
  </div>
</section>
