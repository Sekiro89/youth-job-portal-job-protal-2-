<span class="badge badge--<%= job.status === "inactive" ? "warning" : h.statusBadge(job.status) %>"><%= job.status === "inactive" ? "Paused" : h.statusLabel(job.status) %></span><% if (job.status === 'active' && job.cancel_at_period_end) { %> <span class="badge badge--warning">Ends <%= h.formatDate(job.current_period_end || job.expires_at) %></span><% } %>
