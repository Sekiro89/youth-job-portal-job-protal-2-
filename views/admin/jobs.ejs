<% const qs = (o) => { const p = new URLSearchParams({ status, q, ...o }); [...p.keys()].forEach(k => { if (!p.get(k)) p.delete(k); }); const t = p.toString(); return t ? '?' + t : ''; }; %>
<section class="container dash">
  <%- include('_nav') %>
  <div class="dash__main">
    <header class="app-head">
      <div>
        <p class="eyebrow">Admin</p>
        <h1>Jobs</h1>
        <p class="lead">Every posting on the site, including archived ones. Only <strong>Active</strong> jobs whose paid period has not ended are visible to the public.</p>
      </div>
    </header>

    <div class="filter-tabs" aria-label="Filter by status">
      <% [['all','All'],['active','Active'],['pending_payment','Awaiting payment'],['draft','Draft'],['archived','Archived'],['expired','Expired'],['cancelled','Cancelled'],['inactive','Inactive']].forEach(([k,l]) => { %>
        <a href="/admin/jobs<%= qs({ status: k === 'all' ? '' : k }) %>" class="<%= status === k ? 'is-active' : '' %>"><%= l %> <span class="count"><%= counts[k] %></span></a>
      <% }) %>
    </div>

    <form method="get" action="/admin/jobs" class="filter-bar">
      <input type="hidden" name="status" value="<%= status %>">
      <label class="visually-hidden" for="q">Search</label>
      <input class="input" id="q" name="q" type="search" value="<%= q %>" placeholder="Search title, company, owner, city or Posting ID">
      <button class="kds-btn kds-btn--brand" type="submit">Search</button>
      <% if (q) { %><a class="kds-btn kds-btn--ghost" href="/admin/jobs<%= qs({ q: '' }) %>">Clear</a><% } %>
    </form>

    <% if (!rows.length) { %><div class="empty"><p>No jobs match.</p><a class="kds-btn kds-btn--ghost" href="/admin/jobs">Show all jobs</a></div><% } else { %>
    <div class="card card--table">
      <div class="table-wrap"><table class="table table--stack table--stack-lg jobs-table">
        <thead><tr><th>Posting</th><th>Status</th><th>Dates</th><th>Activity</th><th>Actions</th></tr></thead>
        <tbody>
          <% rows.forEach(j => { const archived = C.ARCHIVED_STATUSES.includes(j.status); const isPublic = j.status === 'active' && j.expires_at && new Date(j.expires_at) > new Date(); const pid = (typeof j.public_id !== 'undefined' && j.public_id) ? j.public_id : ''; const loc = h.location(j); %>
            <tr>
              <td data-label="Posting" class="td--main"><div class="cell">
                <% if (isPublic) { %><a href="/jobs/<%= j.slug %>" class="row-title" target="_blank" rel="noopener"><%= j.title %></a><% } else { %><span class="row-title"><%= j.title %></span><% } %>
                <br><span class="muted small">Posting ID <% if (pid) { %><code class="pid"><%= pid %></code><% } else { %><span title="Allocated when the posting is first published">pending</span><% } %> · #<%= j.id %><% if (loc) { %> · <%= loc %><% } %></span>
                <br><span class="small"><a href="/companies/<%= j.company_slug %>"><%= j.company_name %></a> <span class="muted">· owner <a href="/admin/users?q=<%= encodeURIComponent(j.owner_email) %>"><%= j.owner_name %></a> (<%= j.owner_role %>)</span></span>
              </div></td>
              <td data-label="Status"><span class="badge badge--<%= h.statusBadge(j.status) %>"><%= h.statusLabel(j.status) %></span><% if (j.sub_cancel_at_end && j.status === 'active') { %><br><span class="small muted">cancels at period end</span><% } %></td>
              <td data-label="Dates">
                <span class="dates"><span><span class="muted">Published</span> <%= j.published_at ? h.formatDate(j.published_at) : '—' %></span><span><span class="muted">Expires</span> <%= j.expires_at ? h.formatDate(j.expires_at) : '—' %></span><% if (typeof j.application_deadline !== 'undefined' && j.application_deadline) { %><span><span class="muted">Closes</span> <%= h.formatDate(j.application_deadline) %><% if (j.applications_closed) { %> <span class="badge badge--xs badge--warning">closed</span><% } %></span><% } %></span>
              </td>
              <td data-label="Activity"><span class="dates"><span><%= j.views %> view<%= j.views === 1 ? '' : 's' %></span><span><%= j.applicants %> applicant<%= j.applicants === 1 ? '' : 's' %></span></span></td>
              <td data-label="Actions">
                <div class="cluster">
                  <% if (isPublic) { %><a class="kds-btn kds-btn--ghost kds-btn--sm" href="/jobs/<%= j.slug %>?print=1" target="_blank" rel="noopener" title="Open the public posting ready to print">Printable</a><% } %>
                  <% if (j.last_receipt_id) { %><a class="kds-btn kds-btn--ghost kds-btn--sm" href="/billing/receipt/<%= j.last_receipt_id %>" target="_blank" rel="noopener">Receipt</a><% } %>
                  <% if (!archived && j.status === 'active') { %>
                    <form method="post" action="/admin/jobs/<%= j.id %>/archive" class="inline-form"><button class="kds-btn kds-btn--ghost kds-btn--sm btn-danger-text" type="submit" data-confirm="Take down “<%= j.title %>”? It will disappear from the public site immediately.">Take down</button></form>
                  <% } else if (archived) { %>
                    <% if (j.restorable) { %>
                      <form method="post" action="/admin/jobs/<%= j.id %>/restore" class="inline-form"><button class="kds-btn kds-btn--ghost kds-btn--sm" type="submit" data-confirm="Restore “<%= j.title %>” to the public site?">Restore</button></form>
                    <% } else { %>
                      <span class="muted small" title="No active, paid-up subscription — the owner must publish and pay again.">Not restorable</span>
                    <% } %>
                  <% } else if (!j.last_receipt_id) { %><span class="muted small">—</span><% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
    </div>
    <%- include('_pager', { pg, unit: 'jobs', qs: (o) => qs({ page: '', ...o }) }) %>
    <% } %>
  </div>
</section>
