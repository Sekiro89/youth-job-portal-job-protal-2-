<% const badge = { sent: 'positive', failed: 'danger', logged: 'teal', queued: 'warning' }; %>
<section class="container dash">
  <%- include('_nav') %>
  <div class="dash__main">
    <header class="app-head">
      <div>
        <a href="/admin/outbox" class="back">← Mail outbox</a>
        <p class="eyebrow">Email #<%= m.id %></p>
        <h1 class="msg-title"><%= m.subject %></h1>
        <div class="cluster">
          <span class="badge badge--<%= badge[m.status] || '' %>"><%= m.status %></span>
          <span class="muted small">Created <%= h.formatDateTime(m.created_at) %><% if (m.sent_at) { %> · Sent <%= h.formatDateTime(m.sent_at) %><% } %></span>
        </div>
      </div>
    </header>

    <section class="card">
      <div class="card__head"><h2 class="h3">Delivery</h2></div>
      <dl class="dl">
        <dt>To</dt><dd><%= m.to_email %></dd>
        <dt>From</dt><dd><%= mailFrom %></dd>
        <dt>Status</dt><dd><span class="badge badge--<%= badge[m.status] || '' %>"><%= m.status %></span><% if (m.status === 'logged') { %> <span class="muted small">— not delivered (no email provider configured); this is what the recipient would have received</span><% } %></dd>
        <% if (m.error) { %><dt>Error</dt><dd class="text-danger"><%= m.error %></dd><% } %>
      </dl>
    </section>

    <section class="card">
      <div class="card__head">
        <h2 class="h3">Preview</h2>
        <div class="cluster" role="tablist"><button type="button" class="kds-btn kds-btn--ghost kds-btn--sm is-active" data-mail-view="html" aria-pressed="true">HTML</button><button type="button" class="kds-btn kds-btn--ghost kds-btn--sm" data-mail-view="text" aria-pressed="false">Plain text</button></div>
      </div>
      <% if (m.html) { %>
        <iframe class="mail-preview" data-mail-pane="html" title="Email preview" sandbox="" srcdoc="<%= m.html %>"></iframe>
      <% } else { %><p class="muted" data-mail-pane="html">No HTML body.</p><% } %>
      <pre class="mail-text" data-mail-pane="text" hidden><%= m.text || '(no plain-text body)' %></pre>
    </section>
  </div>
</section>
