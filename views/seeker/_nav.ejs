<%# Seeker side nav — same shell as the portal (.dash__side): pill strip on phones/tablets (edge fades + active tab scrolled into view by seeker.js), column at ≥1024. %>
<% const items = [
  ['dashboard', '/jobseeker/dashboard', 'Dashboard'],
  ['profile', '/jobseeker/profile', 'My profile'],
  ['applications', '/jobseeker/applications', 'Applications'],
  ['saved', '/jobseeker/saved', 'Saved jobs'],
  ['alerts', '/jobseeker/alerts', 'Job alerts'],
  ['notifications', '/jobseeker/notifications', 'Notifications'],
  ['account', '/account', 'Account'],
]; const current = (typeof nav === 'undefined') ? '' : nav; const unread = (typeof unreadCount === 'undefined') ? 0 : Number(unreadCount) || 0; %>
<div class="seeker-side-wrap"><nav class="dash__side" aria-label="Job seeker menu" data-seeker-nav>
  <% items.forEach(([key, href, label]) => { %><a href="<%= href %>" class="<%= current === key ? 'is-active' : '' %>"<%- current === key ? ' aria-current="page"' : '' %>><%= label %><% if (key === 'notifications' && unread > 0) { %> <span class="side-badge" aria-label="<%= unread %> unread"><%= unread > 99 ? '99+' : unread %></span><% } %></a><% }) %>
</nav></div>
