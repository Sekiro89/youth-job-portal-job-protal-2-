<% const items = [
  ['dashboard', '/jobseeker/dashboard', 'Dashboard'],
  ['profile', '/jobseeker/profile', 'My profile'],
  ['applications', '/jobseeker/applications', 'Applications'],
  ['saved', '/jobseeker/saved', 'Saved jobs'],
  ['alerts', '/jobseeker/alerts', 'Job alerts'],
  ['notifications', '/jobseeker/notifications', 'Notifications'],
  ['account', '/account', 'Account'],
]; %>
<nav class="dash__side seeker-side" aria-label="Job seeker menu">
  <% items.forEach(([key, href, label]) => { %>
    <a href="<%= href %>" class="<%= nav === key ? 'is-active' : '' %>" <%= nav === key ? 'aria-current="page"' : '' %>>
      <%= label %><% if (key === 'notifications' && unreadCount > 0) { %> <span class="side-badge" aria-label="<%= unreadCount %> unread"><%= unreadCount > 99 ? '99+' : unreadCount %></span><% } %>
    </a>
  <% }) %>
</nav>
