<% extraCss.push('/css/landing.css') %>
<header class="page-head landing-head">
  <div class="container page-head__inner">
    <div>
      <p class="eyebrow">For Job Seekers · always free</p>
      <h1>Upload your resume once. Apply anywhere in one click</h1>
      <p class="lead">Canada Careers is a Canadian job bank built for everyone: professionals, new immigrants, Indigenous peoples, refugees and youth. Create a free profile and let matching jobs come to you.</p>
      <div class="page-head__actions landing-head__cta">
        <a class="kds-btn kds-btn--accent" href="/signup/seeker">Create job seeker account</a>
        <a class="kds-btn kds-btn--ghost" href="/jobs">Browse jobs</a>
      </div>
      <p class="small muted landing-head__note">No fees, ever · resume never listed publicly · alerts by email or in-app</p>
    </div>
    <div class="landing-head__art" aria-hidden="true">
      <div class="card mock">
        <div class="mock__bar"><span></span><span></span><span></span></div>
        <div class="mock__row"><div class="mock__avatar">A</div><div><div class="mock__line mock__line--w"></div><div class="mock__line"></div></div></div>
        <div class="mock__meter"><span style="width:83%"></span></div>
        <div class="mock__job"><strong>Registered Nurse — Long-Term Care</strong><span>Prairie Health Group · Saskatoon, SK</span><em>Strong match</em></div>
        <div class="mock__job"><strong>Personal Support Worker</strong><span>Regina, SK · $21–$25/hour</span><em>Match</em></div>
        <div class="mock__btn">Apply with saved resume</div>
      </div>
    </div>
  </div>
</header>

<section class="section" id="features">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">What you get</p>
      <h2>Everything a job search needs, nothing you have to pay for</h2>
    </div>
    <div class="grid grid--3">
      <div class="card feature"><div class="feature__icon" aria-hidden="true">1</div><h3>A free account</h3><p>Your profile lives in one place: headline, summary, skills, the categories you want and the provinces you will work in.</p></div>
      <div class="card feature"><div class="feature__icon feature__icon--red" aria-hidden="true">2</div><h3>Upload your resume once</h3><p>PDF, DOC or DOCX. Every application sends it automatically — or attach a different one for a specific role.</p></div>
      <div class="card feature"><div class="feature__icon feature__icon--teal" aria-hidden="true">3</div><h3>Job alerts matched to you</h3><p>When a posting matches your categories, keywords or skills you get an in-app notification and, if you choose, an email — instantly or as a daily digest.</p></div>
    </div>
  </div>
</section>

<%- include('../portal/partials/landing-audiences', { mode: 'seek' }) %>

<section class="section" id="how-it-works">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">How it works</p>
      <h2>Three steps to your next job</h2>
    </div>
    <ol class="grid grid--3 landing-steps">
      <li class="card landing-step"><span class="landing-step__n">1</span><h3>Create your free profile</h3><p>Sign up with your email, add a headline and upload your resume. It takes about five minutes.</p></li>
      <li class="card landing-step"><span class="landing-step__n">2</span><h3>Choose what you want</h3><p>Pick job categories, provinces, keywords and skills. That becomes your alert criteria and your match list.</p></li>
      <li class="card landing-step"><span class="landing-step__n">3</span><h3>Apply in one click</h3><p>See matched jobs on your dashboard, apply with your saved resume, and track every application's status.</p></li>
    </ol>
  </div>
</section>

<section class="section section--alt" id="posting">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">What every posting shows you</p>
      <h2>Job Bank-style postings you can trust</h2>
    </div>
    <div class="grid grid--3">
      <div class="card feature"><h3>A full work address</h3><p>Every posting carries at least one complete work location — street address, city, province and postal code — so you know exactly where the job is before you apply.</p></div>
      <div class="card feature"><h3>The employer’s operating name</h3><p>The name you know the business by is shown first, with the legal company name beneath it — never a hidden agency or a blind ad.</p></div>
      <div class="card feature"><h3>Clear pay and requirements</h3><p>Salary with its period (per hour, day, week, bi-weekly, month or year), education and experience from standard lists, and an industry category — printable on one clean sheet.</p></div>
    </div>
  </div>
</section>

<%- include('../portal/partials/landing-pricing', { signupHref: '/signup/seeker', audienceLabel: 'seeker' }) %>

<%- include('../portal/partials/landing-faq', { items: faqs, audienceLabel: 'job seekers' }) %>

<section class="section section--alt" id="alerts">
  <div class="container">
    <div class="cta-band">
      <div>
        <h2>Ready to start?</h2>
        <p class="muted">Free forever for job seekers. Already have an account? <a href="/login?role=seeker">Sign in</a>.</p>
      </div>
      <div class="cta-band__actions">
        <a class="kds-btn kds-btn--brand" href="/signup/seeker">Create job seeker account</a>
        <a class="kds-btn kds-btn--ghost" href="/jobs">Find jobs</a>
      </div>
    </div>
  </div>
</section>
