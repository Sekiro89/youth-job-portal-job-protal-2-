<% extraCss.push('/css/landing.css') %>
<header class="page-head landing-head">
  <div class="container page-head__inner">
    <div>
      <p class="eyebrow">For Job Seekers · always free</p>
      <h1>Your first job, your next role, your career — start here</h1>
      <p class="lead">Youth Futures Canada is a Canadian job bank built for young people at every career stage — from your first internship to a skilled career. Create a free profile and let matching jobs come to you.</p>
      <div class="page-head__actions landing-head__cta">
        <a class="kds-btn kds-btn--accent" href="/signup/seeker">Create job seeker account</a>
        <a class="kds-btn kds-btn--ghost" href="/jobs">Browse jobs</a>
      </div>
    </div>
  </div>
</header>

<div class="landing-facts-band">
  <ul class="landing-facts container">
    <li><strong>Free</strong><span>always, no fees to seekers</span></li>
    <li><strong>1</strong><span>resume upload, every application</span></li>
    <li><strong>Private</strong><span>never listed publicly</span></li>
    <li><strong>Instant</strong><span>alerts by email or in-app</span></li>
  </ul>
</div>

<section class="section" id="features">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">What you get</p>
      <h2>Everything a job search needs, nothing you have to pay for</h2>
    </div>
    <ul class="landing-tiles landing-tiles--3">
      <li class="landing-tile"><span class="landing-tile__n">01</span><h3>A free account</h3><p>Your profile lives in one place: headline, summary, skills, the categories you want and the provinces you will work in.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">02</span><h3>Upload your resume once</h3><p>PDF, DOC or DOCX. Every application sends it automatically — or attach a different one for a specific role.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">03</span><h3>Job alerts matched to you</h3><p>When a posting matches your categories, keywords or skills you get an in-app notification and, if you choose, an email — instantly or as a daily digest.</p></li>
    </ul>
  </div>
</section>

<%- include('../portal/partials/landing-audiences', { mode: 'seek' }) %>

<section class="section" id="how-it-works">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">How it works</p>
      <h2>Three steps to your next job</h2>
    </div>
    <ol class="landing-tiles landing-tiles--3">
      <li class="landing-tile"><span class="landing-tile__n">01</span><h3>Create your free profile</h3><p>Sign up with your email, add a headline and upload your resume. It takes about five minutes.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">02</span><h3>Choose what you want</h3><p>Pick job categories, provinces, keywords and skills. That becomes your alert criteria and your match list.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">03</span><h3>Apply in one click</h3><p>See matched jobs on your dashboard, apply with your saved resume, and track every application's status.</p></li>
    </ol>
  </div>
</section>

<section class="section section--alt" id="posting">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">What every posting shows you</p>
      <h2>Complete, transparent postings you can trust</h2>
    </div>
    <ul class="landing-tiles landing-tiles--3">
      <li class="landing-tile"><span class="landing-tile__n">01</span><h3>A full work address</h3><p>Every posting carries at least one complete work location — street address, city, province and postal code — so you know exactly where the job is before you apply.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">02</span><h3>The employer's operating name</h3><p>The name you know the business by is shown first, with the legal company name beneath it — never a hidden agency or a blind ad.</p></li>
      <li class="landing-tile"><span class="landing-tile__n">03</span><h3>Clear pay and requirements</h3><p>Salary with its period (per hour, day, week, bi-weekly, month or year), education and experience from standard lists, and an industry category — printable on one clean sheet.</p></li>
    </ul>
  </div>
</section>

<%- include('../portal/partials/landing-pricing', { signupHref: '/signup/seeker', audienceLabel: 'seeker' }) %>

<%- include('../portal/partials/landing-faq', { items: faqs, audienceLabel: 'job seekers' }) %>

<section class="section section--alt" id="alerts">
  <div class="container">
    <div class="cta-band">
      <div>
        <h2>Ready to start?</h2>
        <p class="muted">Free forever for job seekers. Already have an account? <a href="/login?role=seeker">Sign in</a>.</p>
      </div>
      <div class="cta-band__actions">
        <a class="kds-btn kds-btn--brand" href="/signup/seeker">Create job seeker account</a>
        <a class="kds-btn kds-btn--ghost" href="/jobs">Find jobs</a>
      </div>
    </div>
  </div>
</section>
