<% extraCss.push('/css/landing.css') %>
<header class="page-head landing-head">
  <div class="container page-head__inner">
    <div>
      <p class="eyebrow">For Job Seekers · always free</p>
      <h1>Your first job, your next role, your career — start here</h1>
      <p class="lead">Youth Careers Canada is a Canadian job bank built for young people at every career stage — from your first internship to a skilled career. Create a free profile and let matching jobs come to you.</p>
      <ol class="career-track" aria-label="Your career progression">
        <li class="is-active">Start</li><li>Experience</li><li>Career</li>
      </ol>
      <div class="page-head__actions landing-head__cta">
        <a class="kds-btn kds-btn--accent" href="/signup/seeker">Create job seeker account</a>
        <a class="kds-btn kds-btn--ghost" href="/jobs">Browse jobs</a>
      </div>
    </div>
  </div>
</header>

<div class="landing-facts-band">
  <ul class="landing-facts container">
    <li><strong>Free</strong><span>always, no fees to seekers</span></li>
    <li><strong>1</strong><span>resume upload, every application</span></li>
    <li><strong>Private</strong><span>never listed publicly</span></li>
    <li><strong>Instant</strong><span>alerts by email or in-app</span></li>
  </ul>
</div>

<%
  // "Where are you starting?" — one connected vertical path; all five stages and their descriptions/opportunity
  // counts are shown at once (same careerStages data/count query the homepage's "Explore Your Path" cards and
  // the Job Bank's own ?stage= filter use, routes/seeker.js). Static, non-interactive markup — no <details>,
  // no click-to-expand — a plain hover tint on each row is the only affordance.
  const STAGE_COPY = { student: 'Part-time and student-friendly work that fits around your studies.', intern_coop: 'Internships and co-ops that turn what you\'re learning into real experience.', graduate: 'Your first full-time role after finishing your studies.', early_career: 'Entry-level and junior roles to build your track record.', skilled: 'Technical, trade and experienced roles that match the skills you\'ve already built.' };
%>
<section class="section section--alt" id="starting-point">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Choose your starting point</p>
      <h2>Where are you starting?</h2>
      <p class="lead">Youth Careers Canada supports the full journey — not just your first job, but every move after it.</p>
    </div>
    <ol class="stage-path">
      <% careerStages.forEach((s, i) => { %>
        <li class="stage-path__stop">
          <div class="stage-path__row">
            <span class="stage-path__node" aria-hidden="true"><%= i + 1 %></span>
            <span class="stage-path__title"><%= s.name %></span>
            <% if (i === 0) { %><span class="stage-path__tag">Start here</span><% } %>
          </div>
          <div class="stage-path__detail">
            <p class="stage-path__desc"><%= STAGE_COPY[s.key] %></p>
            <a class="stage-path__cta" href="/jobs?stage=<%= s.key %>"><%= s.n %> opportunit<%= s.n === 1 ? 'y' : 'ies' %> →</a>
          </div>
        </li>
      <% }) %>
    </ol>
  </div>
</section>

<section class="section" id="features">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">What you get</p>
      <h2>Everything a job search needs, nothing you have to pay for</h2>
    </div>
    <ul class="benefits-strip">
      <li><span class="benefits-strip__n">01</span><h3>A free account</h3><p>Your profile lives in one place: headline, summary, skills, the categories you want and the provinces you will work in.</p></li>
      <li><span class="benefits-strip__n">02</span><h3>Upload your resume once</h3><p>PDF, DOC or DOCX. Every application sends it automatically — or attach a different one for a specific role.</p></li>
      <li><span class="benefits-strip__n">03</span><h3>Job alerts matched to you</h3><p>When a posting matches your categories, keywords or skills you get an in-app notification and, if you choose, an email — instantly or as a daily digest.</p></li>
    </ul>
  </div>
</section>

<%- include('../partials/lane', { categories, compassPaths, eyebrow: 'Find your lane' }) %>

<section class="section" id="how-it-works">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Make your next move</p>
      <h2>One journey, four steps</h2>
    </div>
    <ol class="workflow-chain workflow-chain--vertical">
      <li class="workflow-chain__step"><h3>Create your profile</h3><p>Sign up with your email, add a headline and upload your resume. It takes about five minutes.</p></li>
      <li class="workflow-chain__step"><h3>Find what you want</h3><p>Pick job categories, provinces, keywords and skills. That becomes your alert criteria and your match list.</p></li>
      <li class="workflow-chain__step"><h3>Apply</h3><p>See matched jobs on your dashboard and apply in one click with your saved resume.</p></li>
      <li class="workflow-chain__step"><h3>Track your application</h3><p>Every application's status — submitted, viewed, shortlisted — stays visible on your Applications page.</p></li>
    </ol>
  </div>
</section>

<%- include('../portal/partials/posting-specimen', {
  eyebrow: 'Know what you\'re applying for',
  heading: 'Complete, transparent postings you can trust',
  lead: 'Real street address, unit, postal code — never just a city — so you know the commute before you ever hit apply. The brand name leads every posting, legal entity noted beneath it.',
  identityLabel: 'Employer',
  identityNote: 'Registered as 1234567 Ontario Inc.',
}) %>

<%- include('../portal/partials/landing-pricing', { signupHref: '/signup/seeker', audienceLabel: 'seeker' }) %>

<%- include('../portal/partials/landing-faq', { items: faqs, groups: faqGroups, audienceLabel: 'job seekers', intro: 'What you need to know before you start your job search.' }) %>

<section class="section section--alt" id="alerts">
  <div class="container">
    <div class="cta-band">
      <div>
        <h2>Ready to start?</h2>
        <p class="muted">Free forever for job seekers. Already have an account? <a href="/login?role=seeker">Sign in</a>.</p>
      </div>
      <div class="cta-band__actions">
        <a class="kds-btn kds-btn--brand" href="/signup/seeker">Create job seeker account</a>
        <a class="kds-btn kds-btn--ghost" href="/jobs">Find jobs</a>
      </div>
    </div>
  </div>
</section>
