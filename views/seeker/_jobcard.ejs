<%# Seeker job card (dashboard matches, saved jobs). `job` = full jobs row (+ applied/saved/score flags); pass { actions: false } to hide the button row. %>
<% const jcLegal = h.legalNameNote(job), jcMore = (job.location_count || 1) - 1, jcHours = h.formatHours(job);
   const jcClosed = typeof job.applications_closed === 'boolean' ? job.applications_closed : false; %>
<article class="job-card">
  <h3 class="job-card__title"><a href="/jobs/<%= job.slug %>"><%= job.title %></a></h3>
  <div class="job-card__company"><%= h.displayCompany(job) %> · <%= h.location(job) %><% if (jcMore > 0) { %> <span class="job-card__more-loc">+<%= jcMore %> more location<%= jcMore > 1 ? 's' : '' %></span><% } %></div>
  <% if (jcLegal) { %><div class="small muted job-card__legal"><%= jcLegal %></div><% } %>
  <div class="job-card__meta"><span><%= h.jobTypeName(job.job_type) %></span><span><%= h.workArrangementName(job.work_arrangement) %></span><% if (jcHours) { %><span class="job-card__hours"><%= jcHours %></span><% } %><span class="job-card__salary"><%= h.formatSalary(job) %></span></div>
  <% if ((job.audiences || []).length) { %><div class="cluster"><% job.audiences.forEach(a => { %><span class="aud aud--<%= a %>"><%= h.audienceName(a) %></span><% }) %></div><% } %>
  <div class="job-card__foot">
    <span>Posted <%= h.timeAgo(job.published_at) %><% if (job.public_id) { %> · Posting ID <%= job.public_id %><% } %></span>
    <span><%= h.categoryName(job.category) %></span>
  </div>
  <% if (typeof actions === 'undefined' || actions) { %>
  <div class="job-card__actions">
    <% if (job.applied) { %><span class="badge badge--positive">Applied</span><% } else if (jcClosed) { %><span class="badge badge--danger">Applications closed</span><% } else { %><a class="kds-btn kds-btn--brand" href="/jobs/<%= job.slug %>/apply">Apply</a><% } %>
    <% if (job.saved) { %>
      <form method="post" action="/jobs/<%= job.slug %>/unsave" class="inline-form"><button class="kds-btn kds-btn--ghost" type="submit">Unsave</button></form>
    <% } else { %>
      <form method="post" action="/jobs/<%= job.slug %>/save" class="inline-form"><button class="kds-btn kds-btn--ghost" type="submit">Save</button></form>
    <% } %>
    <% if (typeof job.score === 'number' && job.score > 0) { %><span class="match-score" title="<%= job.audience_hit ? 'This employer is hiring for people like you' : 'Match score' %>"><%= job.score >= 4 ? 'Strong match' : 'Match' %><%= job.audience_hit ? ' · hiring for you' : '' %></span><% } %>
  </div>
  <% } %>
</article>
