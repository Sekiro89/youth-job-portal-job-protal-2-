<% const company = h.displayCompany(job), legal = h.legalNameNote(job), locs = job.locations || [], primary = locs[0] || job; %>
<div class="container apply-page">
  <p class="small"><a href="/jobs/<%= job.slug %>">← Back to job</a></p>
  <div class="apply-page__grid">
    <aside class="card card--flat apply-job">
      <p class="eyebrow">You are applying to</p>
      <h2 class="h3"><%= job.title %></h2>
      <div class="apply-job__company"><strong><%= company %></strong><% if (legal) { %> <span class="small muted">(<%= legal %>)</span><% } %></div>
      <div class="muted apply-job__loc">
        <%= primary.street_address ? h.fullAddress(primary) : h.location(primary) %>
        <% if (locs.length > 1) { %><span class="small">· +<%= locs.length - 1 %> more location<%= locs.length > 2 ? 's' : '' %></span><% } %>
      </div>
      <div class="job-card__meta"><span><%= h.jobTypeName(job.job_type) %></span><span><%= h.workArrangementName(job.work_arrangement) %></span><span class="job-card__salary"><%= h.formatSalary(job) %></span></div>
      <div class="cluster"><% (job.audiences || []).forEach(a => { %><span class="aud aud--<%= a %>"><%= h.audienceName(a) %></span><% }) %></div>
    </aside>

    <div class="apply-main">
      <h1>Apply for <%= job.title %></h1>
      <% if (gate === 'guest') { %>
        <div class="card apply-gate" role="region" aria-labelledby="gate-h">
          <p class="eyebrow">Free for job seekers</p>
          <h2 id="gate-h" class="h3">Create a free job seeker profile to apply — takes one minute</h2>
          <p class="muted">Upload your resume once and apply to <%= company %> and every other posting in one click. Already have a profile? Sign in and we bring you straight back here.</p>
          <div class="apply-gate__actions">
            <a class="kds-btn kds-btn--accent" href="/signup/seeker?next=<%= encodeURIComponent(returnTo) %>">Create my free profile</a>
            <a class="kds-btn kds-btn--ghost" href="/login?role=seeker&next=<%= encodeURIComponent(returnTo) %>">Sign in</a>
          </div>
          <ul class="apply-gate__points">
            <li>Always free — no fees, ever</li>
            <li>Your resume goes only to <%= company %></li>
            <li>Get alerts when similar jobs go live</li>
          </ul>
        </div>
      <% } else if (gate === 'role') { %>
        <div class="card apply-gate" role="region" aria-labelledby="gate-h">
          <h2 id="gate-h" class="h3">Only job seeker accounts can apply</h2>
          <p class="muted">You are signed in as <strong><%= user.email %></strong> (<%= user.role === 'consultant' ? 'third party consultant' : user.role %> account). Employer and consultant accounts post and manage jobs; they cannot send applications. To apply as a job seeker, sign out and create a separate free job seeker profile with another email address.</p>
          <div class="apply-gate__actions">
            <a class="kds-btn kds-btn--brand" href="/jobs/<%= job.slug %>">Back to the posting</a>
            <a class="kds-btn kds-btn--ghost" href="<%= user.role === 'consultant' ? '/consultant/dashboard' : user.role === 'admin' ? '/admin' : '/employer/dashboard' %>">My dashboard</a>
          </div>
        </div>
      <% } else if (existing) { %>
        <div class="card stack">
          <p><strong>You applied on <%= h.formatDate(existing.created_at) %>.</strong> Status: <span class="badge"><%= existing.status.charAt(0).toUpperCase() + existing.status.slice(1) %></span></p>
          <p class="muted">Resume sent: <%= existing.resume_name %><% if (existing.cover_letter_path) { %><br>Cover sheet: <a href="/jobseeker/applications/<%= existing.id %>/cover"><%= existing.cover_letter_name %></a><% } %></p>
          <div class="cluster"><a class="kds-btn kds-btn--brand" href="/jobseeker/applications">My applications</a><a class="kds-btn kds-btn--ghost" href="/jobs">Find more jobs</a></div>
        </div>
      <% } else { %>
        <form method="post" action="/jobs/<%= job.slug %>/apply" enctype="multipart/form-data" class="form apply-form" novalidate>
          <div class="card stack">
            <div class="split"><h2 class="h3">Your details</h2><a class="small" href="/account">Edit</a></div>
            <p><strong><%= user.name %></strong><br><span class="muted"><%= user.email %></span><% if (profile.headline) { %><br><span class="muted"><%= profile.headline %></span><% } %></p>
          </div>

          <fieldset class="card stack">
            <legend class="h3">Resume</legend>
            <% if (errors.resume) { %><p class="error" role="alert"><%= errors.resume %></p><% } %>
            <div class="stack resume-choice">
              <% if (profile.resume_path) { %>
                <p class="auto-attach"><span class="auto-attach__icon" aria-hidden="true">📎</span><span>Your profile resume <strong><%= profile.resume_name %></strong> will be attached automatically.<br><span class="small muted">Uploaded <%= h.formatDate(profile.resume_uploaded_at) %> · <a href="/jobseeker/resume">download</a></span></span></p>
                <label class="check"><input type="radio" name="resume_choice" value="profile" <%= values.resume_choice === 'profile' ? 'checked' : '' %> data-resume-choice> <span>Use my profile resume</span></label>
                <label class="check"><input type="radio" name="resume_choice" value="upload" <%= values.resume_choice === 'upload' ? 'checked' : '' %> data-resume-choice> <span>Upload a different resume for this job</span></label>
              <% } else { %>
                <input type="hidden" name="resume_choice" value="upload">
                <p class="muted">You have no resume on your profile yet — upload one now. Next time it will be attached automatically.</p>
              <% } %>
              <div class="field upload-box resume-upload" data-resume-upload <%= values.resume_choice === 'upload' ? '' : 'hidden' %>>
                <label for="resume">Resume file</label>
                <input class="input input--file" type="file" id="resume" name="resume" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document">
                <span class="hint">PDF, DOC or DOCX · up to <%= Math.round(C.RESUME_MAX_BYTES / 1024 / 1024) %> MB</span>
                <label class="check"><input type="checkbox" name="save_to_profile" value="1" <%= values.save_to_profile ? 'checked' : '' %>> Save this resume to my profile for one-click applications</label>
              </div>
            </div>
          </fieldset>

          <fieldset class="card stack">
            <legend class="h3">Cover letter <span class="muted small">(optional)</span></legend>
            <p class="muted apply-cover__intro">Type a short note or upload a cover sheet — either is fine.</p>
            <div class="field">
              <label for="cover_letter">Short note to <%= company %></label>
              <textarea class="input" id="cover_letter" name="cover_letter" rows="6" maxlength="3000" data-counter="cover-count" placeholder="Tell <%= company %> why you are a good fit. A few short paragraphs is plenty."><%= values.cover_letter %></textarea>
              <span class="hint"><span id="cover-count"><%= values.cover_letter.length %></span> / 3000 characters</span>
              <% if (errors.cover_letter) { %><span class="error"><%= errors.cover_letter %></span><% } %>
            </div>
            <div class="apply-or" aria-hidden="true"><span>or</span></div>
            <div class="field upload-box <%= errors.cover_file ? 'upload-box--error' : '' %>">
              <label for="cover_file">Upload a cover sheet</label>
              <input class="input input--file" type="file" id="cover_file" name="cover_file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" <% if (errors.cover_file) { %>aria-invalid="true" aria-describedby="err-cover_file"<% } %>>
              <span class="hint">PDF, DOC or DOCX · up to <%= Math.round(C.RESUME_MAX_BYTES / 1024 / 1024) %> MB · sent to <%= company %> with your resume</span>
              <% if (errors.cover_file) { %><span class="error" id="err-cover_file" role="alert"><%= errors.cover_file %></span><% } %>
            </div>
          </fieldset>

          <div class="form-actions sticky-actions">
            <button class="kds-btn kds-btn--accent" type="submit">Send application</button>
            <span class="small muted">Your resume and cover sheet go only to <%= company %>.</span>
          </div>
        </form>
      <% } %>
    </div>
  </div>
</div>
