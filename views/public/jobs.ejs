<script>document.documentElement.classList.add('js')</script>
<div class="page-head">
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><span aria-current="page">Jobs</span></nav>
    <h1><%= heading %></h1>
    <p class="muted results-count" aria-live="polite"><strong><%= total %></strong> job<%= total === 1 ? '' : 's' %> found<%= pages > 1 ? ` · page ${f.page} of ${pages}` : '' %></p>
  </div>
</div>

<div class="container jobs-layout">
  <aside class="filters" id="filters">
    <button class="filters__toggle kds-btn kds-btn--ghost" type="button" aria-expanded="false" aria-controls="filters-body">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 5h18M6 12h12M10 19h4"/></svg>
      Filters<% if (chips.length) { %> <span class="badge"><%= chips.length %></span><% } %>
    </button>
    <form class="filters__body" id="filters-body" method="get" action="/jobs">
      <div class="filters__head"><h2>Filter jobs</h2><% if (chips.length) { %><a href="/jobs" class="small">Clear all</a><% } %></div>
      <div class="field">
        <label for="f-q">Keyword</label>
        <input class="input" id="f-q" name="q" type="search" value="<%= f.q %>" placeholder="Title, skill or company">
      </div>
      <div class="field">
        <label for="f-category">Category</label>
        <select class="input" id="f-category" name="category">
          <option value="">All categories</option>
          <% C.CATEGORIES.forEach(([k, n]) => { %><option value="<%= k %>" <%= f.category === k ? 'selected' : '' %>><%= n %></option><% }) %>
        </select>
      </div>
      <div class="field">
        <label for="f-province">Province / territory</label>
        <select class="input" id="f-province" name="province">
          <option value="">All of Canada</option>
          <% C.PROVINCES.forEach(([k, n]) => { %><option value="<%= k %>" <%= f.province === k ? 'selected' : '' %>><%= n %></option><% }) %>
        </select>
      </div>
      <div class="field">
        <label for="f-city">City</label>
        <input class="input" id="f-city" name="city" value="<%= f.city %>" placeholder="e.g. Saskatoon" autocomplete="off">
      </div>
      <div class="field">
        <label for="f-type">Job type</label>
        <select class="input" id="f-type" name="job_type">
          <option value="">Any type</option>
          <% C.JOB_TYPES.forEach(([k, n]) => { %><option value="<%= k %>" <%= f.job_type === k ? 'selected' : '' %>><%= n %></option><% }) %>
        </select>
      </div>
      <fieldset class="field filters__fieldset">
        <legend>Work arrangement</legend>
        <div class="seg" role="group">
          <label class="seg__opt"><input type="radio" name="work_arrangement" value="" <%= !f.work_arrangement ? 'checked' : '' %>><span>Any</span></label>
          <% C.WORK_ARRANGEMENTS.forEach(([k, n]) => { %><label class="seg__opt"><input type="radio" name="work_arrangement" value="<%= k %>" <%= f.work_arrangement === k ? 'checked' : '' %>><span><%= n %></span></label><% }) %>
        </div>
      </fieldset>
      <fieldset class="field filters__fieldset">
        <legend>Community</legend>
        <div class="checks checks--1">
          <% C.AUDIENCES.forEach(([k, n]) => { %>
            <label class="check"><input type="checkbox" name="audience" value="<%= k %>" <%= f.audience.includes(k) ? 'checked' : '' %>><span class="aud aud--<%= k %>"><%= n %></span></label>
          <% }) %>
        </div>
      </fieldset>
      <div class="field">
        <label for="f-salary">Minimum salary <span class="muted small">(per year, hourly rates annualised)</span></label>
        <select class="input" id="f-salary" name="salary_min">
          <option value="">Any salary</option>
          <% salaryOptions.forEach(s => { %><option value="<%= s %>" <%= f.salary_min === s ? 'selected' : '' %>>$<%= s.toLocaleString('en-CA') %>+</option><% }) %>
        </select>
      </div>
      <% if (f.sort !== 'newest') { %><input type="hidden" name="sort" value="<%= f.sort %>"><% } %>
      <div class="form-actions filters__actions">
        <button class="kds-btn kds-btn--brand kds-btn--block" type="submit">Show results</button>
      </div>
    </form>
  </aside>

  <section class="results" aria-labelledby="results-h">
    <div class="results__bar">
      <h2 id="results-h" class="visually-hidden">Results</h2>
      <% if (chips.length) { %>
        <ul class="chips" aria-label="Active filters">
          <% chips.forEach(c => { %><li><a class="chip" href="<%= c.href %>" aria-label="Remove filter <%= c.label %>"><span><%= c.label %></span><span class="chip__x" aria-hidden="true">×</span></a></li><% }) %>
          <li><a class="chip chip--clear" href="/jobs">Clear all</a></li>
        </ul>
      <% } else { %>
        <p class="muted small results__hint">Showing all open positions across Canada.</p>
      <% } %>
      <label class="sort">
        <span class="small muted">Sort</span>
        <select class="input" name="sort" form="filters-body" data-autosubmit>
          <option value="newest" <%= f.sort === 'newest' ? 'selected' : '' %>>Newest</option>
          <option value="salary" <%= f.sort === 'salary' ? 'selected' : '' %>>Highest salary</option>
        </select>
      </label>
    </div>

    <% if (jobs.length) { %>
      <div class="results__list">
        <% jobs.forEach(job => { %><%- include('_job-card', { job }) %><% }) %>
      </div>
      <% if (pages > 1) { %>
        <nav class="pager" aria-label="Pagination">
          <% if (f.page > 1) { %><a class="kds-btn kds-btn--ghost" href="<%= jobsUrl(f, { page: f.page - 1 }) %>" rel="prev">← Previous</a><% } else { %><span class="kds-btn kds-btn--ghost" aria-disabled="true">← Previous</span><% } %>
          <span class="pager__pages">
            <% for (let p = Math.max(1, f.page - 2); p <= Math.min(pages, f.page + 2); p++) { %>
              <% if (p === f.page) { %><span class="pager__num is-current" aria-current="page"><%= p %></span><% } else { %><a class="pager__num" href="<%= jobsUrl(f, { page: p }) %>"><%= p %></a><% } %>
            <% } %>
          </span>
          <% if (f.page < pages) { %><a class="kds-btn kds-btn--ghost" href="<%= jobsUrl(f, { page: f.page + 1 }) %>" rel="next">Next →</a><% } else { %><span class="kds-btn kds-btn--ghost" aria-disabled="true">Next →</span><% } %>
        </nav>
      <% } %>
    <% } else { %>
      <div class="empty results__empty">
        <h3>No jobs match those filters</h3>
        <p>Try removing a filter, widening the location, or checking spelling.</p>
        <p class="cluster results__empty-actions"><a class="kds-btn kds-btn--brand" href="/jobs">See all jobs</a><a class="kds-btn kds-btn--ghost" href="/jobseeker#alerts">Set a job alert</a></p>
      </div>
    <% } %>
  </section>
</div>
