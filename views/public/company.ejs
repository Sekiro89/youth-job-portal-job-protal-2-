<%# Employer profile page: page-head band + one prose-width column (about card, locations + map card, open jobs). %>
<% const legalNote = h.legalNameNote(co); %>
<% if (typeof mapConfig !== 'undefined' && mapConfig) { %><script>window.CC_MAPS = <%- JSON.stringify(mapConfig).replace(/</g, '\\u003c') %>;</script><% } %>
<header class="page-head co-head">
  <div class="container page-head__inner">
    <div>
      <ol class="breadcrumb"><li><a href="/">Home</a></li><li><a href="/jobs">Jobs</a></li><li aria-current="page"><%= companyName %></li></ol>
      <div class="co-head__row">
        <% if (co.logo_path) { %><img class="co-logo co-logo--img" src="/logos/<%= co.id %>" alt="<%= companyName %> logo" width="64" height="64"><% } else { %><span class="co-logo co-logo--mark" aria-hidden="true"><%= (companyName || '?').trim()[0].toUpperCase() %></span><% } %>
        <div class="co-head__text">
          <h1><%= companyName %></h1>
          <% if (legalNote) { %><p class="co-head__legal small muted"><%= legalNote %></p><% } %>
        </div>
      </div>
      <p class="lead co-head__meta">
        <% const bits = [industryText, address, co.company_size ? `${co.company_size} employees` : '', `${jobs.length} open job${jobs.length === 1 ? '' : 's'}`].filter(Boolean); %>
        <%= bits.join(' · ') %>
      </p>
    </div>
    <% if (co.website) { %><div class="page-head__actions"><a class="kds-btn kds-btn--ghost" href="<%= co.website %>" target="_blank" rel="noopener nofollow">Visit website ↗</a></div><% } %>
  </div>
</header>

<div class="section">
  <div class="container co-stack">
    <%# ---------- Meet the employer — an open editorial section, not a bordered "About" card. ---------- %>
    <section class="co-meet" aria-labelledby="co-about-h">
      <p class="eyebrow">Meet the employer</p>
      <h2 id="co-about-h" class="visually-hidden">About <%= companyName %></h2>
      <% if (co.description) { %><div class="prose"><%- h.paragraphs(co.description) %></div><% } else { %><p class="muted">This employer has not added a description yet.</p><% } %>
      <dl class="facts facts--cols co-meet__facts">
        <% if (legalNote) { %>
          <div><dt>Operating name</dt><dd><%= companyName %></dd></div>
          <div><dt>Legal name</dt><dd><%= co.company_name %></dd></div>
        <% } %>
        <% if (industryText) { %><div><dt>Industry</dt><dd><%= industryText %></dd></div><% } %>
        <% if (co.company_size) { %><div><dt>Size</dt><dd><%= co.company_size %> employees</dd></div><% } %>
        <% if (address) { %><div><dt>Address</dt><dd><%= address %><%= co.country && co.country !== 'Canada' ? ', ' + co.country : '' %></dd></div><% } %>
        <% if (co.website) { %><div><dt>Website</dt><dd><a href="<%= co.website %>" target="_blank" rel="noopener nofollow"><%= co.website.replace(/^https?:\/\//, '') %></a></dd></div><% } %>
        <div><dt>On Youth Futures Canada since</dt><dd><%= h.formatDate(co.created_at, { day: undefined }) %></dd></div>
      </dl>
    </section>

    <%# ---------- Where you could work — an editorial split: the real map (~60%) beside the existing locations
         as numbered destinations (~40%), not a full-width map with a plain link list underneath. ---------- %>
    <% if (coLocations.length) { %>
      <% const NUM_WORDS = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten']; const placeWord = NUM_WORDS[coLocations.length] || coLocations.length; %>
      <section class="co-where" aria-labelledby="co-loc-h">
        <p class="eyebrow">Where you could work</p>
        <h2 id="co-loc-h"><%= placeWord %> place<%= coLocations.length === 1 ? '' : 's' %> to start.</h2>
        <div class="co-where__grid">
          <% if (mapMarkers.length) { %>
            <div class="cc-map co-where__map" data-map data-zoom="13" data-markers="<%= JSON.stringify(mapMarkers) %>" data-empty="Map unavailable" role="region" aria-label="Map of <%= companyName %> locations"></div>
          <% } else { %>
            <p class="small muted">Map unavailable — use the links below.</p>
          <% } %>
          <ol class="co-loc-list">
            <% coLocations.forEach(l => { %>
              <li>
                <p class="co-loc-list__addr"><% if (l.label) { %><span class="co-locations__label"><%= l.label %></span><% } %><span><%= h.fullAddress(l) %></span><% if (l.is_default && coLocations.length > 1) { %> <span class="small muted">(main)</span><% } %></p>
                <a class="co-loc-list__link" href="<%= gmapsUrl(l) %>" target="_blank" rel="noopener nofollow">Open in Google Maps →</a>
              </li>
            <% }) %>
          </ol>
        </div>
      </section>
    <% } %>

    <%# ---------- Your opportunities here — the same numbered "next move" editorial row used on /jobs and the
         job detail page's related jobs (views/public/_job-row.ejs), not grey job cards. ---------- %>
    <section class="co-jobs" aria-labelledby="co-jobs-h">
      <div class="section__head">
        <p class="eyebrow">Your opportunities here</p>
        <h2 id="co-jobs-h"><strong><%= jobs.length %></strong> opportunit<%= jobs.length === 1 ? 'y' : 'ies' %> at <%= companyName %></h2>
      </div>
      <% if (jobs.length) { %>
        <div class="jsearch__list"><% jobs.forEach(job => { %><%- include('_job-row', { job }) %><% }) %></div>
      <% } else { %>
        <div class="empty"><p><%= companyName %> has no open positions right now.</p><a class="kds-btn kds-btn--brand" href="/jobs">Browse all jobs</a></div>
      <% } %>
    </section>
  </div>
</div>

<%# ---------- Final CTA — the same sitewide "next move" close used on the job detail page (op-final), a
     shorter/compact variant with a company-specific line instead of the job page's kicker. ---------- %>
<section class="op-final op-final--compact" aria-labelledby="co-final-h">
  <div class="container op-final__inner">
    <h2 id="co-final-h">Ready for your next move?</h2>
    <p class="op-final__lead">Explore the opportunities waiting at <%= companyName %>.</p>
    <a class="kds-btn kds-btn--accent kds-btn--lg" href="/jobs">Explore opportunities →</a>
  </div>
</section>
