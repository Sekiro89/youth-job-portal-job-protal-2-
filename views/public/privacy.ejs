<div class="section">
  <div class="container container--prose">
    <nav class="card card--flat legal__toc" aria-label="On this page">
      <strong>On this page</strong>
      <ol>
        <li><a href="#collect">What we collect</a></li><li><a href="#use">How we use it</a></li><li><a href="#share">Who we share it with</a></li>
        <li><a href="#keep">Storage and retention</a></li><li><a href="#rights">Your rights</a></li><li><a href="#cookies">Cookies</a></li><li><a href="#contact">Contact</a></li>
