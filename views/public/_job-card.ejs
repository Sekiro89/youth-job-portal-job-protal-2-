<%# Job card (home "Latest jobs", job page "More from / Similar", company page). Operating name first, "+N more locations",
    decimal-aware salary, small Posting ID in the footer, calm reference tag for Job Bank rows, "Applications closed" when past deadline. %>
<% const extra = (job.location_count || 1) - 1; const hours = h.formatHours(job); const km = job.distance_km == null ? '' : (job.distance_km < 1 ? '< 1 km' : `≈ ${Math.round(job.distance_km)} km`);
   const isRef = job.source === 'jobbank'; const closed = !!job.applications_closed; const pid = job.public_id || ''; %>
<article class="job-card<%= isRef ? ' job-card--ref' : '' %>">
  <h3 class="job-card__title"><a href="/jobs/<%= job.slug %>"><%= job.title %></a></h3>
  <div class="job-card__company"><span class="job-card__co"><%= h.displayCompany(job) %></span> <span class="job-card__loc">· <%= h.location(job) %><% if (extra > 0) { %> <span class="job-card__more">+<%= extra %> more location<%= extra > 1 ? 's' : '' %></span><% } %><% if (km) { %> <span class="job-card__dist" title="Distance to the nearest work location"><%= km %></span><% } %></span></div>
  <div class="job-card__meta"><span><%= h.jobTypeName(job.job_type) %></span><span><%= h.workArrangementName(job.work_arrangement) %></span><% if (hours) { %><span><%= hours %></span><% } %><span class="job-card__salary"><%= h.formatSalary(job) %></span></div>
  <% if ((job.audiences || []).length || isRef || closed) { %>
    <div class="cluster">
      <% (job.audiences || []).forEach(a => { %><span class="aud aud--<%= a %>"><%= h.audienceName(a) %></span><% }) %>
      <% if (isRef) { %><span class="badge badge--teal job-card__ref" title="Reference posting from Job Bank (Government of Canada) — not posted on Canada Careers">Reference posting · Job Bank</span><% } %>
      <% if (closed) { %><span class="badge badge--danger">Applications closed</span><% } %>
    </div>
  <% } %>
  <div class="job-card__foot">
    <span>Posted <%= h.timeAgo(job.published_at) %> · <%= h.categoryName(job.category) %></span>
    <% if (pid) { %><span class="job-card__pid" title="Posting ID">ID <span><%= pid %></span></span><% } %>
  </div>
</article>
