<% const extra = (job.location_count || 1) - 1; const hours = h.formatHours(job); const km = job.distance_km == null ? '' : (job.distance_km < 1 ? '< 1 km' : `≈ ${Math.round(job.distance_km)} km`); %>
<article class="job-card">
  <h3 class="job-card__title"><a href="/jobs/<%= job.slug %>"><%= job.title %></a></h3>
  <div class="job-card__company"><%= h.displayCompany(job) %> · <%= h.location(job) %><% if (extra > 0) { %> <span class="job-card__more">+<%= extra %> more location<%= extra > 1 ? 's' : '' %></span><% } %><% if (km) { %> <span class="job-card__dist" title="Distance to the nearest work location"><%= km %></span><% } %></div>
  <div class="job-card__meta"><span><%= h.jobTypeName(job.job_type) %></span><span><%= h.workArrangementName(job.work_arrangement) %></span><% if (hours) { %><span><%= hours %></span><% } %><span class="job-card__salary"><%= h.formatSalary(job) %></span></div>
  <% if ((job.audiences || []).length) { %><div class="cluster"><% job.audiences.forEach(a => { %><span class="aud aud--<%= a %>"><%= h.audienceName(a) %></span><% }) %></div><% } %>
  <div class="job-card__foot">
    <span>Posted <%= h.timeAgo(job.published_at) %></span>
    <span><%= h.categoryName(job.category) %></span>
  </div>
  <% if (job.source === 'jobbank') { %><p class="job-card__ref">Reference posting from Job Bank (Government of Canada) — not posted on Canada Careers</p><% } %>
</article>
