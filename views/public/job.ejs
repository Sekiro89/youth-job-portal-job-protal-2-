<% const remote = job.work_arrangement === 'remote'; const closes = h.formatDate(job.expires_at); const posted = h.formatDate(job.published_at || job.created_at);
   const mailto = job.apply_email ? `mailto:${job.apply_email}?subject=${encodeURIComponent('Application: ' + job.title)}` : '';
   const legalNote = h.legalNameNote(job); // "Operated by <legal name>" when the operating (trade) name differs
   const extraLoc = locations.length - 1;
   // Imported (Job Bank) postings are reference-only: applications happen on jobbank.gc.ca, so the JSON-LD must not claim direct apply and should point at the source.
   const imported = job.source === 'jobbank' && !!job.source_url;
   const REF_TEXT = 'Reference posting from Job Bank (Government of Canada) — not posted on Canada Careers';
   if (imported && typeof jsonLd !== 'undefined' && Array.isArray(jsonLd)) jsonLd.forEach(o => { if (o && o['@type'] === 'JobPosting') { o.directApply = false; o.url = job.source_url; } }); %>
<link rel="stylesheet" href="/css/print.css" media="print">
<div class="page-head job-head">
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">›</span><a href="/jobs">Jobs</a><span aria-hidden="true">›</span><a href="/jobs?category=<%= job.category %>"><%= h.categoryName(job.category) %></a></nav>
    <h1 class="job-head__title"><%= job.title %></h1>
    <p class="job-head__company">
      <a href="/companies/<%= job.company_slug %>"><%= companyName %></a>
      <span class="job-head__dot" aria-hidden="true">·</span>
      <span><%= h.location(job) %><% if (extraLoc > 0) { %> <span class="job-head__more">+<%= extraLoc %> more location<%= extraLoc > 1 ? 's' : '' %></span><% } %><%= remote ? ' (remote across Canada)' : '' %></span>
    </p>
    <% if (legalNote) { %><p class="job-head__legal small muted"><%= legalNote %></p><% } %>
    <% if (imported) { %><p class="job-head__ref"><span class="badge badge--teal badge--ref"><%= REF_TEXT %></span></p><% } %>
    <ul class="job-head__meta" aria-label="Key facts">
      <li><%= h.jobTypeName(job.job_type) %></li>
      <li><%= h.workArrangementName(job.work_arrangement) %></li>
      <li class="job-head__salary"><%= h.formatSalary(job) %></li>
      <% if (experienceText) { %><li><%= experienceText %></li><% } %>
    </ul>
    <p class="print-only print-dates">Posted <%= posted %> · Closes <%= closes %> · <%= job.vacancies %> vacanc<%= job.vacancies === 1 ? 'y' : 'ies' %></p>
    <% if ((job.audiences || []).length) { %><div class="cluster job-head__aud"><span class="small muted">Welcomes:</span><% job.audiences.forEach(a => { %><a class="aud aud--<%= a %>" href="/jobs?audience=<%= a %>"><%= h.audienceName(a) %></a><% }) %></div><% } %>
  </div>
</div>

<div class="container job-layout">
  <article class="job-main">
    <% if (imported) { %>
      <aside class="card card--flat job-attribution" aria-labelledby="attribution-h">
        <h2 id="attribution-h" class="small eyebrow">Reference posting</h2>
        <p><strong><%= REF_TEXT %>.</strong> It is republished here for reference with attribution; applications are made on Job Bank, not on Canada Careers.</p>
        <p class="cluster"><a class="kds-btn kds-btn--brand" href="<%= job.source_url %>" target="_blank" rel="nofollow noopener">Apply on Job Bank →</a><span class="small muted">Job Bank posting #<%= job.source_id %></span></p>
      </aside>
    <% } %>
    <section class="job-section job-locations" aria-labelledby="loc-h">
      <h2 id="loc-h">Work location<%= locations.length > 1 ? `s (${locations.length})` : '' %></h2>
      <ul class="locations">
        <% locations.forEach((l, i) => { %>
          <li class="locations__item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <span class="locations__addr"><%= h.fullAddress(l) %><% if (i === 0 && locations.length > 1) { %> <span class="small muted">(primary)</span><% } %></span>
          </li>
        <% }) %>
      </ul>
      <% if (remote) { %><p class="small muted locations__note">This role is remote across Canada; the address shown is the employer's base.</p><% } %>
    </section>
    <section class="job-section">
      <h2>About the role</h2>
      <div class="prose"><%- h.paragraphs(job.description) %></div>
    </section>
    <% if (job.requirements) { %>
      <section class="job-section">
        <h2>Requirements</h2>
        <div class="prose"><%- h.paragraphs(job.requirements) %></div>
      </section>
    <% } %>
    <% if (job.benefits) { %>
      <section class="job-section">
        <h2>Benefits</h2>
        <div class="prose"><%- h.paragraphs(job.benefits) %></div>
      </section>
    <% } %>
    <% if ((job.skills || []).length) { %>
      <section class="job-section">
        <h2>Skills</h2>
        <ul class="cluster tags"><% job.skills.forEach(s => { %><li class="tag"><%= s %></li><% }) %></ul>
      </section>
    <% } %>
    <section class="job-section job-about-co">
      <h2>About <%= companyName %></h2>
      <% if (legalNote) { %><p class="small muted"><%= legalNote %></p><% } %>
      <% if (job.company_description) { %><div class="prose"><%- h.paragraphs(job.company_description) %></div><% } %>
      <p class="cluster small muted">
        <% if (job.company_industry) { %><span><%= job.company_industry %></span><% } %>
        <% if (job.company_size) { %><span><%= job.company_size %> employees</span><% } %>
        <% if (job.company_city) { %><span><%= h.location({ city: job.company_city, province: job.company_province }) %></span><% } %>
      </p>
      <a href="/companies/<%= job.company_slug %>">All jobs from <%= companyName %> →</a>
    </section>
    <section class="job-section print-only print-apply">
      <h2>How to apply</h2>
      <% if (imported) { %>
        <p>This is a reference posting. Apply on Job Bank (Government of Canada): <%= job.source_url %></p>
      <% } else { %>
        <p>Apply online at <%= printHost %>/jobs/<%= job.slug %><% if (job.apply_url) { %>, on the company site at <%= job.apply_url %><% } %><% if (job.apply_email) { %>, or by email to <%= job.apply_email %><% } %>.</p>
      <% } %>
    </section>
  </article>

  <aside class="job-side">
    <div class="card apply-card">
      <% if (imported) { %>
        <a class="kds-btn kds-btn--accent kds-btn--block apply-card__primary" href="<%= job.source_url %>" target="_blank" rel="nofollow noopener">Apply on Job Bank ↗</a>
        <p class="small muted apply-card__note">Opens the original posting on jobbank.gc.ca (Government of Canada).</p>
      <% } else { %>
        <a class="kds-btn kds-btn--accent kds-btn--block apply-card__primary" href="/jobs/<%= job.slug %>/apply">Apply now</a>
        <% if (job.apply_url) { %><a class="kds-btn kds-btn--ghost kds-btn--block" href="<%= job.apply_url %>" target="_blank" rel="noopener nofollow">Apply on company site ↗</a><% } else if (mailto) { %><a class="kds-btn kds-btn--ghost kds-btn--block" href="<%= mailto %>">Apply by email</a><% } %>
      <% } %>
      <form method="post" action="/jobs/<%= job.slug %>/<%= saved ? 'unsave' : 'save' %>" class="apply-card__save">
        <button class="kds-btn kds-btn--ghost kds-btn--block" type="submit" aria-pressed="<%= saved ? 'true' : 'false' %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="<%= saved ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg>
          <%= saved ? 'Saved' : 'Save job' %>
        </button>
      </form>
      <button class="kds-btn kds-btn--ghost kds-btn--block apply-card__print" type="button" data-print>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="9" rx="2"/><path d="M6 14h12v7H6z"/></svg>
        Print / save as PDF
      </button>
      <dl class="facts">
        <% if (legalNote) { %>
          <div><dt>Operating name</dt><dd><%= companyName %></dd></div>
          <div><dt>Legal name</dt><dd><%= legalName %></dd></div>
        <% } %>
        <div><dt>Posted</dt><dd><time datetime="<%= new Date(job.published_at || job.created_at).toISOString() %>"><%= posted %></time></dd></div>
        <div><dt>Closes</dt><dd><time datetime="<%= new Date(job.expires_at).toISOString() %>"><%= closes %></time></dd></div>
        <div><dt>Vacancies</dt><dd><%= job.vacancies %></dd></div>
        <div><dt>Salary</dt><dd><%= h.formatSalary(job) %></dd></div>
        <div><dt>Category</dt><dd><a href="/jobs?category=<%= job.category %>"><%= h.categoryName(job.category) %></a></dd></div>
        <% if (experienceText) { %><div><dt>Experience</dt><dd><%= experienceText %></dd></div><% } %>
        <% if (educationText) { %><div><dt>Education</dt><dd><%= educationText %></dd></div><% } %>
        <% if ((job.languages || []).length) { %><div><dt>Languages</dt><dd><%= job.languages.join(', ') %></dd></div><% } %>
        <% if (job.noc_code) { %><div><dt>NOC</dt><dd><%= job.noc_code %></dd></div><% } %>
        <% if (imported) { %><div><dt>Source</dt><dd><a href="<%= job.source_url %>" target="_blank" rel="nofollow noopener">Job Bank #<%= job.source_id %></a></dd></div><% } %>
      </dl>
      <div class="share" aria-label="Share this job">
        <span class="small muted">Share</span>
        <button class="share__btn" type="button" data-share="copy" data-url="<%= url %>" aria-label="Copy link"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg></button>
        <a class="share__btn" href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(url) %>" target="_blank" rel="noopener" aria-label="Share on LinkedIn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.4c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21H9z"/></svg></a>
        <a class="share__btn" href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(url) %>&text=<%= encodeURIComponent(job.title + ' — ' + companyName + ' (' + h.location(job) + ')') %>" target="_blank" rel="noopener" aria-label="Share on X"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 3h3l-7.2 8.2L21.8 21h-6.6l-4.6-6-5.3 6H2.3l7.7-8.8L1.9 3h6.8l4.2 5.5zm-1.2 16h1.8L7 4.9H5.1z"/></svg></a>
        <a class="share__btn" href="mailto:?subject=<%= encodeURIComponent(job.title + ' at ' + companyName) %>&body=<%= encodeURIComponent('I thought you might be interested in this job on Canada Careers: ' + url) %>" aria-label="Share by email"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></a>
        <span class="share__status small" role="status" aria-live="polite"></span>
      </div>
      <p class="small muted apply-card__note">Job ID <%= job.slug %><% if (imported) { %> · <%= REF_TEXT %><% } %> · <a href="/contact?category=posting">Report this posting</a></p>
    </div>
  </aside>
  <p class="print-only print-foot">Printed from <%= printHost %>/jobs/<%= job.slug %> on <%= printedOn %></p>
</div>

<% if (more.length || similar.length) { %>
<div class="container related">
  <% if (more.length) { %>
    <section class="related__block" aria-labelledby="more-h">
      <div class="split section-head"><h2 id="more-h">More jobs from <%= companyName %></h2><a href="/companies/<%= job.company_slug %>">View company →</a></div>
      <div class="jobs-grid"><% more.forEach(j => { %><%- include('_job-card', { job: j }) %><% }) %></div>
    </section>
  <% } %>
  <% if (similar.length) { %>
    <section class="related__block" aria-labelledby="similar-h">
      <div class="split section-head"><h2 id="similar-h">Similar jobs</h2><a href="/jobs?category=<%= job.category %>">All <%= h.categoryName(job.category) %> jobs →</a></div>
      <div class="jobs-grid"><% similar.forEach(j => { %><%- include('_job-card', { job: j }) %><% }) %></div>
    </section>
  <% } %>
</div>
<% } %>

<div class="applybar" role="region" aria-label="Apply">
  <div class="applybar__inner">
    <div class="applybar__text"><strong><%= h.formatSalary(job) %></strong><span class="small muted">Closes <%= closes %></span></div>
    <form method="post" action="/jobs/<%= job.slug %>/<%= saved ? 'unsave' : 'save' %>" class="inline-form"><button class="kds-btn kds-btn--ghost applybar__save" type="submit" aria-label="<%= saved ? 'Unsave job' : 'Save job' %>"><svg width="20" height="20" viewBox="0 0 24 24" fill="<%= saved ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg></button></form>
    <% if (imported) { %><a class="kds-btn kds-btn--accent applybar__apply" href="<%= job.source_url %>" target="_blank" rel="nofollow noopener">Apply on Job Bank ↗</a><% } else { %><a class="kds-btn kds-btn--accent applybar__apply" href="/jobs/<%= job.slug %>/apply">Apply now</a><% } %>
  </div>
</div>
