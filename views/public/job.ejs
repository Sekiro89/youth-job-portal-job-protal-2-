<%
  // Public job detail. Round-3 variables (docs/TEMPLATE-VARS-R3.md) are used when the route provides them and derived from
  // the same rules otherwise, so this template renders for every state: active / locked, Job Bank reference rows, past
  // application deadline, 1 or many locations, missing salary / hours / operating name.
  const remote = job.work_arrangement === 'remote';
  const legalNote = h.legalNameNote(job); // "Operated by <legal name>" when the operating (trade) name differs
  const extraLoc = locations.length - 1;
  const mailto = job.apply_email ? `mailto:${job.apply_email}?subject=${encodeURIComponent('Application: ' + job.title)}` : '';
  // Imported postings carry no on-site application: the only CTA is the employer's external link (never named as a source).
  const imported = job.source === 'jobbank' && !!job.source_url;
  // Application deadline (DATE column). Calendar day = server-local getters on a Date, or the first 10 chars of a string.
  const ymd = (v) => !v ? '' : (v instanceof Date ? `${v.getFullYear()}-${String(v.getMonth() + 1).padStart(2, '0')}-${String(v.getDate()).padStart(2, '0')}` : String(v).slice(0, 10));
  const todayYmd = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Toronto' });
  const deadlineYmd = job.application_deadline_date || ymd(job.application_deadline);
  const hasDeadline = !!deadlineYmd;
  const closed = typeof job.applications_closed === 'boolean' ? job.applications_closed : (hasDeadline && deadlineYmd < todayYmd);
  const closesDate = (typeof closesAt !== 'undefined' && closesAt) ? closesAt : (hasDeadline ? new Date(deadlineYmd + 'T16:00:00Z') : job.expires_at);
  const closes = h.formatDate(closesDate);
  const expiry = h.formatDate(job.expires_at);
  const closesLbl = typeof closesLabel !== 'undefined' && closesLabel ? closesLabel : (hasDeadline ? 'Applications close' : 'Closes');
  const postedDate = (typeof postedAt !== 'undefined' && postedAt) ? postedAt : (job.published_at || job.created_at);
  const posted = h.formatDate(postedDate);
  const otherLabel = typeof applyUrlLabel !== 'undefined' && applyUrlLabel ? applyUrlLabel : 'Apply on other platform';
  const pid = job.public_id || '';
  const canApply = !imported && !closed;
  const hours = typeof hoursText !== 'undefined' ? hoursText : h.formatHours(job);
  // JSON-LD: identifier = Posting ID, validThrough = deadline (end of that day, Toronto) or billing expiry; reference rows never claim direct apply.
  if (typeof jsonLd !== 'undefined' && Array.isArray(jsonLd)) jsonLd.forEach(o => {
    if (!o || o['@type'] !== 'JobPosting') return;
    if (pid) o.identifier = { '@type': 'PropertyValue', name: companyName, value: pid };
    if (hasDeadline) {
      const off = (new Intl.DateTimeFormat('en-US', { timeZone: 'America/Toronto', timeZoneName: 'longOffset' }).formatToParts(new Date(deadlineYmd + 'T12:00:00Z')).find(p => p.type === 'timeZoneName') || {}).value || 'GMT-05:00';
      o.validThrough = `${deadlineYmd}T23:59:59${off.replace('GMT', '') || '-05:00'}`;
    } else if (job.expires_at) o.validThrough = new Date(job.expires_at).toISOString();
    if (imported) { o.directApply = false; }
    else if (closed) o.directApply = false;
  });
%>
<link rel="stylesheet" href="/css/print.css" media="print">
<% if (typeof mapConfig !== 'undefined' && mapConfig) { %><script>window.CC_MAPS = <%- JSON.stringify(mapConfig).replace(/</g, '\\u003c') %>;</script><% } %>
<header class="page-head job-head">
  <div class="container page-head__inner">
    <div>
      <ol class="breadcrumb"><li><a href="/">Home</a></li><li><a href="/jobs">Jobs</a></li><li><a href="/jobs?category=<%= job.category %>"><%= h.categoryName(job.category) %></a></li></ol>
      <h1 class="job-head__title"><%= job.title %></h1>
      <p class="job-head__company">
        <a href="/companies/<%= job.company_slug %>"><%= companyName %></a>
        <span><span class="job-head__dot" aria-hidden="true">· </span><%= h.location(job) %><% if (extraLoc > 0) { %> <span class="job-head__more">+<%= extraLoc %> more location<%= extraLoc > 1 ? 's' : '' %></span><% } %><%= remote ? ' (remote across Canada)' : '' %></span>
      </p>
      <% if (legalNote) { %><p class="job-head__legal small muted"><%= legalNote %></p><% } %>
      <% if (closed) { %>
        <div class="cluster job-head__badges">
          <% if (closed) { %><span class="badge badge--danger">Applications closed</span><% } %>
        </div>
      <% } %>
      <ul class="job-head__meta" aria-label="Key facts">
        <li><%= h.jobTypeName(job.job_type) %></li>
        <li><%= h.workArrangementName(job.work_arrangement) %></li>
        <li class="job-head__salary"><%= h.formatSalary(job) %></li>
        <% if (hours) { %><li class="job-head__hours"><%= hours %></li><% } %>
        <% if (experienceText) { %><li><%= experienceText %></li><% } %>
      </ul>
      <p class="print-only print-dates"><% if (pid) { %>Posting ID <%= pid %> · <% } %>Posted <%= posted %> · <%= closesLbl %> <%= closes %> · <%= job.vacancies %> vacanc<%= job.vacancies === 1 ? 'y' : 'ies' %></p>
    </div>
  </div>
</header>

<div class="section">
<div class="container job-layout">
  <article class="job-main">
    <% if (closed) { %>
      <aside class="card closed-notice" role="status" aria-labelledby="closed-h">
        <h2 id="closed-h" class="eyebrow">Applications closed</h2>
        <p>This posting stopped accepting applications on <strong><%= closes %></strong>. It stays listed for reference until <%= expiry %>.</p>
        <p class="closed-notice__meta"><a href="/jobs?category=<%= job.category %>">See other <%= h.categoryName(job.category) %> jobs →</a></p>
      </aside>
    <% } %>
    <section class="job-section job-locations" aria-labelledby="loc-h">
      <h2 id="loc-h">Work location<%= locations.length > 1 ? `s (${locations.length})` : '' %></h2>
      <ul class="locations">
        <% locations.forEach((l, i) => { %>
          <li class="locations__item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <span class="locations__addr"><%= h.fullAddress(l) %><% if (i === 0 && locations.length > 1) { %> <span class="small muted">(primary)</span><% } %></span>
            <a class="locations__map-link" href="<%= gmapsUrl(l) %>" target="_blank" rel="noopener nofollow" aria-label="Open <%= h.fullAddress(l) %> in Google Maps">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
              Open in Google Maps
            </a>
          </li>
        <% }) %>
      </ul>
      <% if (remote) { %><p class="small muted locations__note">This role is remote across Canada; the address shown is the employer’s base.</p><% } %>
      <div class="card map-block">
        <% if (mapMarkers.length) { %>
          <div class="cc-map" data-map data-zoom="14" data-markers="<%= JSON.stringify(mapMarkers) %>" data-empty="Map unavailable" role="region" aria-label="Map of work location<%= mapMarkers.length > 1 ? 's' : '' %>"></div>
          <p class="map-block__note small muted"><%= mapMarkers.length %> of <%= locations.length %> location<%= locations.length === 1 ? '' : 's' %> shown on the map. Pins are approximate.</p>
        <% } else { %>
          <p class="map-block__note small muted">Map unavailable for this posting — use the “Open in Google Maps” link<%= locations.length > 1 ? 's' : '' %> above.</p>
        <% } %>
      </div>
    </section>
    <section class="job-section">
      <h2>About the role</h2>
      <div class="prose"><%- h.paragraphs(job.description) %></div>
    </section>
    <% if (job.requirements) { %>
      <section class="job-section">
        <h2>Requirements</h2>
        <div class="prose"><%- h.paragraphs(job.requirements) %></div>
      </section>
    <% } %>
    <% if (job.benefits) { %>
      <section class="job-section">
        <h2>Benefits</h2>
        <div class="prose"><%- h.paragraphs(job.benefits) %></div>
      </section>
    <% } %>
    <% if ((job.skills || []).length) { %>
      <section class="job-section">
        <h2>Skills</h2>
        <ul class="cluster tags"><% job.skills.forEach(s => { %><li class="tag"><%= s %></li><% }) %></ul>
      </section>
    <% } %>
    <section class="card card--flat job-section job-about-co">
      <h2>About <%= companyName %></h2>
      <% if (legalNote) { %><p class="small muted"><%= legalNote %></p><% } %>
      <% if (job.company_description) { %><div class="prose"><%- h.paragraphs(job.company_description) %></div><% } %>
      <p class="cluster small muted">
        <% if (industryText) { %><span><%= industryText %></span><% } %>
        <% if (job.company_size) { %><span><%= job.company_size %> employees</span><% } %>
        <% if (job.company_city) { %><span><%= h.location({ city: job.company_city, province: job.company_province }) %></span><% } %>
      </p>
      <p><a href="/companies/<%= job.company_slug %>">All jobs from <%= companyName %> →</a></p>
    </section>
    <section class="job-section print-only print-apply">
      <h2>How to apply</h2>
      <% if (imported) { %>
        <p>Apply on the employer's platform: <%= printHost %>/jobs/<%= job.slug %>/go</p>
      <% } else if (closed) { %>
        <p>Applications closed on <%= closes %>. The posting remains listed at <%= printHost %>/jobs/<%= job.slug %> until <%= expiry %>.</p>
      <% } else { %>
        <p>Apply online at <%= printHost %>/jobs/<%= job.slug %><% if (job.apply_url) { %>, on the other platform at <%= job.apply_url %><% } %><% if (job.apply_email) { %>, or by email to <%= job.apply_email %><% } %>.</p>
      <% } %>
    </section>
  </article>

  <aside class="job-side">
    <div class="card apply-card">
      <% if (imported) { %>
        <a class="kds-btn kds-btn--accent kds-btn--block apply-card__primary" href="/jobs/<%= job.slug %>/go" target="_blank" rel="nofollow noopener">Apply on other platform ↗</a>
        <p class="small muted apply-card__note">Opens the employer's application page in a new tab.</p>
      <% } else if (closed) { %>
        <div class="apply-card__closed" role="status">
          <strong>Applications closed</strong>
          <span class="small muted">Closed on <%= closes %>. You can still save or print this posting.</span>
        </div>
      <% } else { %>
        <a class="kds-btn kds-btn--accent kds-btn--block apply-card__primary" href="/jobs/<%= job.slug %>/apply">Apply now</a>
        <% if (job.apply_url) { %><a class="kds-btn kds-btn--ghost kds-btn--block" href="<%= job.apply_url %>" target="_blank" rel="noopener nofollow"><%= otherLabel %> ↗</a><% } else if (mailto) { %><a class="kds-btn kds-btn--ghost kds-btn--block" href="<%= mailto %>">Apply by email</a><% } %>
      <% } %>
      <form method="post" action="/jobs/<%= job.slug %>/<%= saved ? 'unsave' : 'save' %>" class="apply-card__save">
        <button class="kds-btn kds-btn--ghost kds-btn--block" type="submit" aria-pressed="<%= saved ? 'true' : 'false' %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="<%= saved ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg>
          <%= saved ? 'Saved' : 'Save job' %>
        </button>
      </form>
      <button class="kds-btn kds-btn--ghost kds-btn--block apply-card__print" type="button" data-print>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="9" rx="2"/><path d="M6 14h12v7H6z"/></svg>
        Print or save as PDF
      </button>
      <dl class="facts">
        <% if (pid) { %><div><dt>Posting ID</dt><dd class="facts__pid"><%= pid %></dd></div><% } %>
        <div><dt>Posted</dt><dd><time datetime="<%= new Date(postedDate).toISOString() %>"><%= posted %></time></dd></div>
        <div><dt><%= closesLbl %></dt><dd><time datetime="<%= hasDeadline ? deadlineYmd : new Date(job.expires_at).toISOString() %>"><%= closes %></time><% if (closed) { %> <span class="badge badge--danger">Closed</span><% } %></dd></div>
        <div><dt>Vacancies</dt><dd><%= job.vacancies %></dd></div>
        <div><dt>Category</dt><dd><a href="/jobs?category=<%= job.category %>"><%= h.categoryName(job.category) %></a></dd></div>
        <% if (experienceText) { %><div><dt>Experience</dt><dd><%= experienceText %></dd></div><% } %>
        <% if (educationText) { %><div><dt>Education</dt><dd><%= educationText %></dd></div><% } %>
        <% if (hours) { %><div><dt>Hours</dt><dd><%= hours %></dd></div><% } %>
        <% if ((job.languages || []).length) { %><div><dt>Languages</dt><dd><%= job.languages.join(', ') %></dd></div><% } %>
        <% if (legalNote) { %>
          <div><dt>Operating name</dt><dd><%= companyName %></dd></div>
          <div><dt>Legal name</dt><dd><%= legalName %></dd></div>
        <% } else { %>
          <div><dt>Company</dt><dd><a href="/companies/<%= job.company_slug %>"><%= companyName %></a></dd></div>
        <% } %>
        <% if (industryText) { %><div><dt>Industry</dt><dd><%= industryText %></dd></div><% } %>
        <% if (job.noc_code) { %><div><dt>NOC</dt><dd><%= job.noc_code %></dd></div><% } %>
      </dl>
      <div class="share" aria-label="Share this job">
        <span class="small muted">Share</span>
        <button class="share__btn" type="button" data-share="copy" data-url="<%= url %>" aria-label="Copy link"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg></button>
        <a class="share__btn" href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(url) %>" target="_blank" rel="noopener" aria-label="Share on LinkedIn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.4c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21H9z"/></svg></a>
        <a class="share__btn" href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(url) %>&text=<%= encodeURIComponent(job.title + ' — ' + companyName + ' (' + h.location(job) + ')') %>" target="_blank" rel="noopener" aria-label="Share on X"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 3h3l-7.2 8.2L21.8 21h-6.6l-4.6-6-5.3 6H2.3l7.7-8.8L1.9 3h6.8l4.2 5.5zm-1.2 16h1.8L7 4.9H5.1z"/></svg></a>
        <a class="share__btn" href="mailto:?subject=<%= encodeURIComponent(job.title + ' at ' + companyName) %>&body=<%= encodeURIComponent('I thought you might be interested in this job on Youth Futures Canada: ' + url) %>" aria-label="Share by email"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></a>
        <span class="share__status small" role="status" aria-live="polite"></span>
      </div>
      <p class="small muted apply-card__note"><% if (pid) { %>Quote <strong>Posting ID <%= pid %></strong> when you contact the employer or our support team. <% } %><a href="/contact?category=posting">Report this posting</a></p>
    </div>
  </aside>
  <p class="print-only print-foot">Printed from <%= printHost %>/jobs/<%= job.slug %> on <%= printedOn %></p>
</div>
</div>

<% if (more.length || similar.length) { %>
<section class="section section--alt related" aria-label="Related jobs">
  <div class="container">
  <% if (more.length) { %>
    <div class="related__block">
      <div class="section__head section__head--split"><div><h2 id="more-h">More jobs from <%= companyName %></h2></div><a href="/companies/<%= job.company_slug %>">View company →</a></div>
      <div class="jobs-grid"><% more.forEach(j => { %><%- include('_job-card', { job: j }) %><% }) %></div>
    </div>
  <% } %>
  <% if (similar.length) { %>
    <div class="related__block">
      <div class="section__head section__head--split"><div><h2 id="similar-h">Similar jobs</h2></div><a href="/jobs?category=<%= job.category %>">All <%= h.categoryName(job.category) %> jobs →</a></div>
      <div class="jobs-grid"><% similar.forEach(j => { %><%- include('_job-card', { job: j }) %><% }) %></div>
    </div>
  <% } %>
  </div>
</section>
<% } %>

<div class="applybar" role="region" aria-label="Apply">
  <div class="applybar__inner">
    <div class="applybar__text"><strong><%= h.formatSalary(job) %></strong><span class="small muted"><%= closed ? 'Applications closed' : closesLbl + ' ' + closes %></span></div>
    <form method="post" action="/jobs/<%= job.slug %>/<%= saved ? 'unsave' : 'save' %>" class="inline-form"><button class="kds-btn kds-btn--ghost applybar__save" type="submit" aria-label="<%= saved ? 'Unsave job' : 'Save job' %>"><svg width="20" height="20" viewBox="0 0 24 24" fill="<%= saved ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg></button></form>
    <% if (imported) { %><a class="kds-btn kds-btn--accent applybar__apply" href="/jobs/<%= job.slug %>/go" target="_blank" rel="nofollow noopener">Apply on other platform ↗</a><% } else if (closed) { %><span class="badge badge--danger applybar__closed">Closed</span><% } else { %><a class="kds-btn kds-btn--accent applybar__apply" href="/jobs/<%= job.slug %>/apply">Apply now</a><% } %>
  </div>
</div>
