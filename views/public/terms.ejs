<div class="legal-doc">
  <div class="container legal-doc__grid">
    <nav class="legal-index" aria-label="Sections">
      <p class="legal-index__label">Terms of use</p>
      <ol>
        <li><a href="#accounts" data-legal-link>01 Accounts</a></li>
        <li><a href="#postings" data-legal-link>02 Job postings</a></li>
        <li><a href="#billing" data-legal-link>03 Pricing and billing</a></li>
