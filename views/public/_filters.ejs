<%# /jobs filter bar + drawer (UX standard §6). ONE form: keyword + a "panel" that is
    - ≥768: display:contents → place/radius/category/province sit in the bar; "More filters" opens a popover (.jsearch__more)
    - <768: a full-screen drawer (opened by the "Filters" button) holding every field with a sticky "Show N results" button.
    Near-me wiring (data-near-*) is handled by public/js/public.js; the drawer/popover/map by public/js/jobs-search.js. %>
<% const hasPoint = !!point; const browserPoint = hasPoint && point.source === 'browser'; %>
<form class="jsearch__form" id="jobs-form" method="get" action="/jobs" role="search" aria-label="Search jobs" data-search-form data-jsearch-form>
  <div class="jsearch__kw">
    <label class="jsearch__label" for="f-q">Search</label>
    <input class="input jsearch__kw-input" id="f-q" name="q" type="search" value="<%= f.q %>" placeholder="Job title, skill or company" autocomplete="off">
    <button class="jsearch__kw-go" type="submit" aria-label="Search">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    </button>
  </div>

  <button class="kds-btn kds-btn--ghost jsearch__open" type="button" aria-expanded="false" aria-controls="jobs-filters" data-drawer-open>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 5h18M6 12h12M10 19h4"/></svg>
    Filters<span class="jsearch__count" data-active-count="<%= chips.length %>" <%= chips.length ? '' : 'hidden' %>><%= chips.length %></span>
  </button>

  <%# role="dialog"/aria-modal are added by jobs-search.js only while the phone drawer is open (on ≥768 the panel is inline). %>
  <div class="jsearch__panel" id="jobs-filters" aria-labelledby="jobs-filters-h" data-drawer>
    <div class="jsearch__panel-head">
      <h2 id="jobs-filters-h">Filters</h2>
      <button class="jsearch__close" type="button" aria-label="Close filters" data-drawer-close>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>

    <div class="jsearch__panel-body">
      <div class="field jsearch__near" data-near>
        <label class="jsearch__label" for="f-near">Location</label>
        <div class="jsearch__near-row">
          <input class="input" id="f-near" name="near" value="<%= f.near %>" placeholder="City or postal code" autocomplete="off" aria-describedby="near-status" data-near-input>
          <button class="kds-btn kds-btn--ghost jsearch__near-me" type="button" data-near-me title="Use my current location">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="8"/></svg>
            <span>Near me</span>
          </button>
        </div>
        <input type="hidden" name="lat" value="<%= browserPoint ? point.lat : '' %>" data-near-lat>
        <input type="hidden" name="lng" value="<%= browserPoint ? point.lng : '' %>" data-near-lng>
        <p class="jsearch__near-status small" id="near-status" role="status" aria-live="polite" data-near-status><% if (browserPoint) { %>Using your current location.<% } else if (f.near_unresolved) { %><span class="is-error">We couldn't find “<%= f.near %>” — try a city and province.</span><% } %></p>
      </div>

      <p class="jsearch__refine-label">Refine your search</p>

      <div class="field jsearch__radius">
        <label class="jsearch__label" for="f-radius">Distance</label>
        <select class="input" id="f-radius" name="radius_km" aria-label="Search radius">
          <% RADII.forEach(r => { %><option value="<%= r %>" <%= f.radius_km === r ? 'selected' : '' %>>Within <%= r %> km</option><% }) %>
        </select>
      </div>

      <div class="field jsearch__cat">
        <label class="jsearch__label" for="f-category">Category</label>
        <select class="input" id="f-category" name="category">
          <option value="">All categories</option>
          <% C.CATEGORIES.forEach(([k, n]) => { %><option value="<%= k %>" <%= f.category.includes(k) ? 'selected' : '' %>><%= n %></option><% }) %>
        </select>
      </div>

      <div class="field jsearch__prov">
        <label class="jsearch__label" for="f-province">Province</label>
        <select class="input" id="f-province" name="province">
          <option value="">All of Canada</option>
          <% C.PROVINCES.forEach(([k, n]) => { %><option value="<%= k %>" <%= f.province === k ? 'selected' : '' %>><%= n %></option><% }) %>
        </select>
      </div>

      <button class="kds-btn kds-btn--ghost jsearch__more-btn" type="button" aria-expanded="false" aria-controls="jobs-more" data-more-open>
        More filters<span class="jsearch__count" data-more-count="<%= moreActive %>" <%= moreActive ? '' : 'hidden' %>><%= moreActive %></span>
        <svg class="jsearch__chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>

      <div class="jsearch__more" id="jobs-more" data-more>
        <div class="jsearch__more-grid">
          <div class="field">
            <label for="f-city">City</label>
            <input class="input" id="f-city" name="city" value="<%= f.city %>" placeholder="e.g. Saskatoon" autocomplete="off">
          </div>
          <div class="field">
            <label for="f-type">Job type</label>
            <select class="input" id="f-type" name="job_type">
              <option value="">Any type</option>
              <% C.JOB_TYPES.forEach(([k, n]) => { %><option value="<%= k %>" <%= f.job_type === k ? 'selected' : '' %>><%= n %></option><% }) %>
            </select>
          </div>
          <fieldset class="field jsearch__fieldset">
            <legend>Work arrangement</legend>
            <div class="jseg" role="group">
              <label class="jseg__opt"><input type="radio" name="work_arrangement" value="" <%= !f.work_arrangement ? 'checked' : '' %>><span>Any</span></label>
              <% C.WORK_ARRANGEMENTS.forEach(([k, n]) => { %><label class="jseg__opt"><input type="radio" name="work_arrangement" value="<%= k %>" <%= f.work_arrangement === k ? 'checked' : '' %>><span><%= n %></span></label><% }) %>
            </div>
          </fieldset>
          <div class="field">
            <label for="f-salary">Minimum salary <span class="muted small">(per year)</span></label>
            <select class="input" id="f-salary" name="salary_min">
              <option value="">Any salary</option>
              <% salaryOptions.forEach(s => { %><option value="<%= s %>" <%= f.salary_min === s ? 'selected' : '' %>>$<%= s.toLocaleString('en-CA') %>+</option><% }) %>
            </select>
          </div>
          <fieldset class="field jsearch__fieldset jsearch__fullwidth">
            <legend>Career stage</legend>
            <div class="checks">
              <label class="check"><input type="radio" name="stage" value="" <%= f.stage ? '' : 'checked' %>><span>Any stage</span></label>
              <% C.CAREER_STAGES.forEach(([k, n]) => { %>
                <label class="check"><input type="radio" name="stage" value="<%= k %>" <%= f.stage === k ? 'checked' : '' %>><span><%= n %></span></label>
              <% }) %>
            </div>
          </fieldset>
        </div>
        <div class="jsearch__more-foot">
          <button class="kds-btn kds-btn--ghost kds-btn--sm" type="button" data-more-reset>Reset these</button>
          <button class="kds-btn kds-btn--brand kds-btn--sm" type="submit">Apply</button>
        </div>
      </div>
    </div>

    <div class="jsearch__panel-foot">
      <button class="kds-btn kds-btn--ghost" type="button" data-drawer-reset>Reset</button>
      <button class="kds-btn kds-btn--brand" type="submit" data-drawer-submit><span>Show <span data-live-total><%= total %></span> result<span data-live-plural><%= total === 1 ? '' : 's' %></span></span></button>
    </div>
  </div>

  <button class="kds-btn kds-btn--accent jsearch__go" type="submit">Search jobs →</button>
  <input type="hidden" name="view" value="<%= f.view === 'map' ? 'map' : '' %>" data-view-field>
</form>
