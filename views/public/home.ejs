<section class="hero hero--journey">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow fade-up fade-up--1">Start your journey</p>
      <h1 class="hero__title fade-up fade-up--1">Where will<br>your career<br><span class="hero__title-accent">take you?</span></h1>
      <p class="lead hero__lead fade-up fade-up--2">Jobs, experience and opportunities for young people across Canada — <strong><%= totals.jobs %></strong> open position<%= totals.jobs === 1 ? '' : 's' %> from <strong><%= totals.companies %></strong> Canadian employer<%= totals.companies === 1 ? '' : 's' %>.</p>
      <div class="hero__cta fade-up fade-up--3">
        <a class="kds-btn kds-btn--accent kds-btn--lg" href="/jobs">Explore jobs →</a>
        <a class="kds-btn kds-btn--ghost kds-btn--lg" href="/about">Learn about Youth Careers →</a>
      </div>
    </div>
    <div class="hero__journey fade-up fade-up--2" aria-hidden="true">
      <svg class="hero__journey-svg" viewBox="0 0 600 600" preserveAspectRatio="xMidYMid meet">
        <defs>
          <radialGradient id="heroJourneyGlow" cx="68%" cy="32%" r="78%">
            <stop offset="0%" stop-color="#fff" stop-opacity=".12"/>
            <stop offset="55%" stop-color="#fff" stop-opacity=".05"/>
            <stop offset="100%" stop-color="#fff" stop-opacity="0"/>
          </radialGradient>
        </defs>
        <path class="hero__journey-land" d="M40,600 L40,430 C20,380 55,340 40,290 C25,235 90,210 110,165 C130,120 190,130 230,95 C270,60 330,75 365,45 C395,20 430,25 455,0 L600,0 L600,600 Z"/>
        <path class="hero__journey-route" d="M58,478 C108,450 138,422 168,392 C208,358 258,330 298,300 C348,268 388,238 428,200 C426,194 466,162 498,120" />
      </svg>
      <ol class="hero__journey-stops">
        <li style="--x:9%; --y:80%"><span class="hero__stop-node" aria-hidden="true"></span><span class="hero__stop-label"><strong>01 Start</strong>Students</span></li>
        <li style="--x:28%; --y:65%"><span class="hero__stop-node" aria-hidden="true"></span><span class="hero__stop-label"><strong>02 Explore</strong>Internships</span></li>
        <li style="--x:50%; --y:50%"><span class="hero__stop-node" aria-hidden="true"></span><span class="hero__stop-label"><strong>03 Build</strong>Early career</span></li>
        <li style="--x:71%; --y:33%"><span class="hero__stop-node" aria-hidden="true"></span><span class="hero__stop-label"><strong>04 Grow</strong>Skilled careers</span></li>
        <li class="is-end" style="--x:83%; --y:20%"><span class="hero__stop-node" aria-hidden="true"></span><span class="hero__stop-label"><strong>05 Move</strong></span></li>
      </ol>
    </div>
  </div>
  <div class="search-band" aria-labelledby="search-h">
    <div class="container search-band__inner">
      <p class="search-band__eyebrow">The next step</p>
      <h2 id="search-h">Find your next opportunity</h2>
      <form class="search-form" method="get" action="/jobs" role="search" aria-label="Search jobs">
        <div class="field search-form__field">
          <label for="hero-q">Search jobs, skills or companies</label>
          <input class="input" id="hero-q" name="q" type="search" placeholder="e.g. warehouse associate" autocomplete="off">
        </div>
        <div class="field search-form__field">
          <label for="hero-loc">City or province</label>
          <select class="input" id="hero-loc" name="loc">
            <option value="">All of Canada</option>
            <optgroup label="Provinces &amp; territories">
              <% provinces.forEach(p => { %><option value="prov:<%= p.key %>"><%= p.name %></option><% }) %>
            </optgroup>
            <% if (cities.length) { %><optgroup label="Cities with open jobs">
              <% cities.forEach(c => { %><option value="city:<%= c %>"><%= c %></option><% }) %>
            </optgroup><% } %>
          </select>
        </div>
        <button class="kds-btn kds-btn--accent search-form__submit" type="submit">Search jobs →</button>
      </form>
      <p class="search-band__popular small">
        <span class="muted">Popular:</span>
        <a href="/jobs?job_type=internship">Internships &amp; co-ops</a>
        <a href="/jobs?work_arrangement=remote">Remote</a>
        <a href="/jobs?category=it_software">IT &amp; software</a>
        <a href="/jobs?category=healthcare">Healthcare</a>
        <a href="/jobs?category=construction_trades">Skilled trades</a>
      </p>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="featured-h">
  <div class="container">
    <div class="section__head section__head--split">
      <div>
        <p class="eyebrow">04 — Opportunities</p>
        <h2 id="featured-h">Opportunities along the way.</h2>
        <p class="lead">Real postings from real Canadian employers — from first internships to experienced hires. Not just junior roles.</p>
      </div>
      <a class="kds-btn kds-btn--ghost" href="/jobs">View the Job Bank →</a>
    </div>
    <% if (featured.length) { %>
      <div class="feat-directory-wrap">
        <div class="feat-directory">
          <% featured.forEach((job, i) => { %><%- include('_featured-row', { job, i }) %><% }) %>
        </div>
      </div>
    <% } else { %>
      <div class="empty"><p>No open positions yet — check back soon, or <a href="/employer">post the first one</a>.</p></div>
    <% } %>
  </div>
</section>

<section class="section surface-warm-yellow" id="career-paths" aria-labelledby="paths-h">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">02 — Explore</p>
      <h2 id="paths-h">Every career starts somewhere.</h2>
      <p class="lead">Young people arrive at Youth Careers Canada from every stage of their journey. Wherever you're starting from, there's a real posting for it.</p>
    </div>
    <% const JOURNEY_LABEL = ['Start', 'Experience', 'Launch', 'Build', 'Move'];
       const STAGE_COPY = {
        student: 'Find student jobs, part-time opportunities and work experience.',
        intern_coop: 'Gain practical experience and connect what you learn with real work.',
        graduate: 'Find opportunities to start your career after completing your studies.',
        early_career: 'Explore entry-level, junior and early-career opportunities.',
        skilled: 'Discover technical, trade and other opportunities that match your skills.',
      }; %>
    <ol class="jstage-list jstage-list--row" style="--jcount: <%= careerStages.length %>">
      <% careerStages.forEach((s, i) => { %>
        <li class="jstage">
          <span class="jstage__node" aria-hidden="true"></span>
          <span class="jstage__label"><%= JOURNEY_LABEL[i] %></span>
          <h3 class="jstage__name"><%= s.name %></h3>
          <p class="jstage__desc"><%= STAGE_COPY[s.key] %> <strong><%= s.n %></strong> open role<%= s.n === 1 ? '' : 's' %>.</p>
          <a class="jstage__link" href="/jobs?stage=<%= s.key %>">Browse roles →</a>
        </li>
      <% }) %>
    </ol>
  </div>
</section>

<%- include('../partials/lane', { categories, compassPaths, eyebrow: '05 — Explore' }) %>

<section class="section" aria-labelledby="how-h">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">06 — How it works</p>
      <h2 id="how-h">Three stops to your next opportunity.</h2>
    </div>
    <ol class="jstage-list jstage-list--row" style="--jcount: 3">
      <li class="jstage">
        <span class="jstage__node" aria-hidden="true"></span>
        <span class="jstage__num">01</span>
        <h3 class="jstage__name">Search</h3>
        <p class="jstage__desc">Search the full Job Bank by keyword, location, category or career stage — every posting is real and current.</p>
      </li>
      <li class="jstage">
        <span class="jstage__node" aria-hidden="true"></span>
        <span class="jstage__num">02</span>
        <h3 class="jstage__name">Explore</h3>
        <p class="jstage__desc">Filter by career stage, industry or province to find roles that fit where you are right now — from your first internship to a skilled career.</p>
      </li>
      <li class="jstage">
        <span class="jstage__node" aria-hidden="true"></span>
        <span class="jstage__num">03</span>
        <h3 class="jstage__name">Apply</h3>
        <p class="jstage__desc">Create a free profile, save your resume once, and apply directly — track every application from your dashboard.</p>
      </li>
    </ol>
    <p class="how-h__links small">
      <a href="/jobs?stage=intern_coop">Find internships &amp; co-ops</a> ·
      <a href="/jobseeker">Build your profile</a> ·
      <a href="/jobs?stage=skilled">Explore skilled trades</a> ·
      <a href="/about">Understand how it works</a>
    </p>
  </div>
</section>

<section class="section section--warm" aria-labelledby="aud-h">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">07 — Audiences</p>
      <h2 id="aud-h">The journey has more than one side.</h2>
    </div>
    <div class="aud-panel">
      <article class="aud-panel__stop aud-panel__stop--lead">
        <span class="aud-panel__tag">For job seekers</span>
        <p class="aud-panel__price">Free <span>always</span></p>
        <p class="aud-panel__desc">Create a profile, upload your resume once and apply in one click — wherever in the world you're applying from.</p>
        <a class="kds-btn kds-btn--accent" href="/jobseeker">Create your profile →</a>
      </article>
      <article class="aud-panel__stop">
        <span class="aud-panel__tag">For employers</span>
        <p class="aud-panel__price">$<%= (C.priceCentsFor('employer') / 100).toFixed(2) %> <span>+ GST / month</span></p>
        <p class="aud-panel__desc">Reach students, graduates and skilled young professionals building a career in Canada.</p>
        <a class="aud-panel__link" href="/employer">Post a job →</a>
      </article>
      <article class="aud-panel__stop">
        <span class="aud-panel__tag">For partners</span>
        <p class="aud-panel__price">$<%= (C.priceCentsFor('consultant') / 100).toFixed(2) %> <span>+ GST / month</span></p>
        <p class="aud-panel__desc">Recruiters and consultants manage every client from one account, one dashboard.</p>
        <a class="aud-panel__link" href="/consultant">Manage clients →</a>
      </article>
    </div>
  </div>
</section>

<section class="section final-cta" aria-labelledby="final-h">
  <div class="container final-cta__inner">
    <div class="final-cta__copy">
      <p class="eyebrow">08 — Your next move</p>
      <h2 id="final-h">Your next move<br>starts here.</h2>
    </div>
    <div class="final-cta__actions">
      <a class="kds-btn kds-btn--accent kds-btn--lg" href="/jobs">Explore jobs →</a>
      <a class="kds-btn kds-btn--ghost kds-btn--lg" href="/about">Learn about Youth Careers →</a>
    </div>
  </div>
</section>
