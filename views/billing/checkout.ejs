<% if (typeof extraCss !== 'undefined' && !extraCss.includes('/css/portal.css')) extraCss.unshift('/css/portal.css'); %>
<header class="page-head"><div class="container page-head__inner">
  <div>
    <p class="eyebrow">Step 2 of 2 · Payment</p>
    <h1>Post your job</h1>
    <p class="lead">One monthly fee per posting at the <%= rateLabel.toLowerCase() %>. It renews automatically until you cancel.</p>
  </div>
  <div class="page-head__actions"><a class="kds-btn kds-btn--ghost" href="<%= base %>/jobs/<%= job.id %>">← Back to the posting</a></div>
</div></header>
<section class="section"><div class="container bill-checkout">
  <div class="card bill-checkout__main">
    <% if (mode === 'sandbox') { %><div class="bill-sandbox-banner" role="note"><strong>Sandbox mode — no real charge.</strong> Payments are simulated until Stripe is connected. The next page is a test card form; use <code>4242 4242 4242 4242</code>.</div><% } %>
    <div class="card__head"><h2>Order summary</h2></div>
    <div class="bill-job">
      <div class="bill-job__title"><%= job.title %></div>
      <div class="bill-job__meta"><%= job.company_name %> · <%= h.location(job) || 'No location' %> · <%= h.jobTypeName(job.job_type) %></div>
      <div class="cluster cluster--tight"><span class="badge badge--<%= h.statusBadge(job.status) %>"><%= h.statusLabel(job.status) %></span><% if (job.public_id) { %><span class="posting-id">Posting ID <b><%= job.public_id %></b></span><% } %></div>
    </div>
    <table class="bill-lines" aria-label="Price breakdown">
      <tbody>
        <tr><td>Monthly posting fee <span class="small muted">(<%= rateLabel %>)</span></td><td class="bill-lines__amt"><%= h.money(sub.price_cents) %></td></tr>
        <tr><td><%= pricing.gst_label %></td><td class="bill-lines__amt"><%= h.money(sub.tax_cents) %></td></tr>
        <tr class="bill-lines__total"><td>Total per month</td><td class="bill-lines__amt"><%= h.money(sub.total_cents) %> <span class="bill-cur">CAD</span></td></tr>
      </tbody>
    </table>
    <p class="bill-renew"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
      <span>Renews automatically every month at <%= h.money(sub.total_cents) %> — the price you see today, locked in for this posting — until you cancel. Cancel any time from <a href="/billing">Billing</a> — no fees, no notice period.</span></p>
    <form method="post" action="/billing/checkout/<%= job.id %>" class="bill-cta">
      <div class="sticky-bar">
        <button type="submit" class="kds-btn kds-btn--accent kds-btn--block kds-btn--lg" data-busy="Redirecting…">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Continue to secure payment
        </button>
      </div>
      <p class="small muted bill-cta__note">
        <% if (mode === 'stripe') { %>You will be taken to Stripe's secure checkout. We never see or store your card number.<% } else { %>Sandbox mode is on — you will see a simulated card page and no real charge is made.<% } %>
        Your posting goes live the moment payment succeeds.
      </p>
    </form>
  </div>
  <aside class="bill-checkout__aside">
    <div class="card card--flat">
      <div class="card__head"><h3>What's included</h3></div>
      <ul class="bill-ticks">
        <li>Live on <%= (typeof site !== "undefined" && site.site_name) || "Youth Futures Canada" %> for a full month, renewed monthly</li>
        <li>Shown to matching job seekers and sent as job alerts</li>
        <li>Unlimited applicants, managed from your dashboard</li>
        <li>Edit the posting any time while it is live</li>
        <li>Itemised GST receipt for every payment — view or download as PDF any time from Billing</li>
      </ul>
    </div>
    <div class="card card--flat">
      <div class="card__head"><h3>Billing details</h3></div>
      <dl class="bill-dl">
        <dt>Name</dt><dd><%= user.name %></dd>
        <dt>Email</dt><dd><%= user.email %></dd>
        <dt>Company</dt><dd><%= job.company_name %></dd>
        <dt>Currency</dt><dd>Canadian dollars (CAD)</dd>
      </dl>
      <p class="small muted">Receipts are emailed to this address; all receipts are available from your login under <a href="/billing">Billing</a>.</p>
    </div>
  </aside>
</div></section>
