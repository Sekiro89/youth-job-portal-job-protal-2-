<div class="page-head">
  <div class="container">
    <p class="eyebrow">Step 2 of 2 · Payment</p>
    <h1>Post your job</h1>
    <p class="muted">One monthly fee per posting. It renews automatically until you cancel.</p>
  </div>
</div>
<section class="container section-pad bill-checkout">
  <div class="bill-checkout__main card">
    <h2 class="bill-h2">Order summary</h2>
    <div class="bill-job">
      <div class="bill-job__title"><%= job.title %></div>
      <div class="bill-job__meta"><%= job.company_name %> · <%= h.location(job) %> · <%= h.jobTypeName(job.job_type) %></div>
      <span class="badge badge--<%= h.statusBadge(job.status) %>"><%= h.statusLabel(job.status) %></span>
    </div>
    <table class="bill-lines" aria-label="Price breakdown">
      <tbody>
        <tr><td>Monthly posting fee</td><td class="bill-lines__amt"><%= h.money(pricing.price_cents) %></td></tr>
        <tr><td><%= pricing.gst_label %></td><td class="bill-lines__amt"><%= h.money(pricing.tax_cents) %></td></tr>
        <tr class="bill-lines__total"><td>Total per month</td><td class="bill-lines__amt"><%= h.money(pricing.total_cents) %> <span class="bill-cur">CAD</span></td></tr>
      </tbody>
    </table>
    <p class="bill-renew"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
      <span>Renews automatically every month until you cancel. Cancel any time from <a href="/billing">Billing</a> — no fees, no notice period.</span></p>
    <form method="post" action="/billing/checkout/<%= job.id %>" class="bill-cta">
      <button type="submit" class="kds-btn kds-btn--brand kds-btn--block kds-btn--lg" data-busy="Redirecting…">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Continue to secure payment
      </button>
      <p class="small muted bill-cta__note">
        <% if (mode === 'stripe') { %>You will be taken to Stripe's secure checkout. We never see or store your card number.<% } else { %>Sandbox mode is on — you will see a simulated card page and no real charge is made.<% } %>
        Your posting goes live the moment payment succeeds.
      </p>
    </form>
    <p class="small"><a href="<%= base %>/jobs/<%= job.id %>">← Back to the posting</a></p>
  </div>
  <aside class="bill-checkout__aside">
    <div class="card card--flat">
      <h3>What's included</h3>
      <ul class="bill-ticks">
        <li>Live on Canada Careers for a full month, renewed monthly</li>
        <li>Shown to matching job seekers and sent as job alerts</li>
        <li>Unlimited applicants, managed from your dashboard</li>
        <li>Edit the posting any time while it is live</li>
        <li>Itemised receipt with GST for every payment</li>
      </ul>
    </div>
    <div class="card card--flat">
      <h3>Billing details</h3>
      <dl class="bill-dl">
        <dt>Name</dt><dd><%= user.name %></dd>
        <dt>Email</dt><dd><%= user.email %></dd>
        <dt>Company</dt><dd><%= job.company_name %></dd>
        <dt>Currency</dt><dd>Canadian dollars (CAD)</dd>
      </dl>
      <p class="small muted">Receipts are emailed to this address and kept under <a href="/billing">Billing</a>.</p>
    </div>
  </aside>
</section>
