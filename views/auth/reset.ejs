<section class="auth container">
  <div class="auth__card">
    <div class="auth__head">
      <p class="eyebrow">Account help</p>
      <h1>Choose a new password</h1>
      <p class="muted">For <strong><%= email %></strong></p>
    </div>
    <%- include('_form-errors', { errors }) %>
    <form class="form" method="post" action="/reset/<%= token %>" novalidate>
      <input type="hidden" name="email" value="<%= email %>" autocomplete="username">
      <%- include('_password', { f: { name: 'password', label: 'New password', error: errors.password, hint: 'At least 8 characters.' } }) %>
      <%- include('_password', { f: { name: 'password_confirm', label: 'Confirm new password', error: errors.password_confirm } }) %>
      <div class="form-actions">
        <button class="kds-btn kds-btn--brand kds-btn--block" type="submit">Save new password</button>
      </div>
    </form>
    <p class="auth__foot"><a href="/login">Back to sign in</a></p>
  </div>
</section>
