<%- include('_head', { h: { eyebrow: 'Back on track', h1: 'Create a new password', leadHtml: 'For <strong>' + email.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</strong>' } }) %>
    <div class="auth__card">
      <%- include('_form-errors', { errors }) %>
      <form class="form" method="post" action="/reset/<%= token %>" novalidate>
        <input type="hidden" name="email" value="<%= email %>" autocomplete="username">
        <%- include('_password', { f: { name: 'password', label: 'New password', error: errors.password, hint: 'At least 8 characters, with a letter and a number.' } }) %>
        <%- include('_password', { f: { name: 'password_confirm', label: 'Confirm new password', error: errors.password_confirm } }) %>
        <div class="form-actions">
          <button class="kds-btn kds-btn--accent kds-btn--block" type="submit">Reset password →</button>
        </div>
      </form>
      <p class="auth__foot">← <a href="/login">Back to sign in</a></p>
    </div>
  </div>
</div>
