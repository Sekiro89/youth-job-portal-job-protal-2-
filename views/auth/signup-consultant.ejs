<section class="auth container">
  <div class="auth__card auth__card--wide">
    <div class="auth__head">
      <p class="eyebrow">Third Party Consultant account</p>
      <h1>Create your consultant account</h1>
      <p class="muted">Manage postings for many employers under one login. <a href="/signup">Not a consultant?</a></p>
    </div>
    <%- include('_form-errors', { errors }) %>
    <form class="form" method="post" action="/signup/consultant" novalidate>
      <%- include('_field', { f: { name: 'name', label: 'Your full name', value: values.name, error: errors.name, autocomplete: 'name' } }) %>
      <div class="form-row">
        <%- include('_field', { f: { name: 'email', label: 'Work email', type: 'email', value: values.email, error: errors.email, autocomplete: 'email', inputmode: 'email' } }) %>
        <%- include('_field', { f: { name: 'phone', label: 'Phone', type: 'tel', value: values.phone, error: errors.phone, autocomplete: 'tel', inputmode: 'tel', required: false, placeholder: '(604) 555-0100' } }) %>
      </div>
      <div class="form-row">
        <%- include('_password', { f: { name: 'password', label: 'Password', error: errors.password, hint: 'At least 8 characters, with a letter and a number.' } }) %>
        <%- include('_password', { f: { name: 'password_confirm', label: 'Confirm password', error: errors.password_confirm } }) %>
      </div>

      <div class="auth-info">
        <strong>How it works</strong>
        <ol>
          <li>Create your account (this step).</li>
          <li>Add an employer profile for each company you represent.</li>
          <li>Post and manage jobs for any of them — $9.99 + GST per posting per month.</li>
        </ol>
      </div>

      <label class="check <%= errors.agree ? 'check--error' : '' %>" for="agree">
        <input type="checkbox" id="agree" name="agree" value="1" <%= values.agree ? 'checked' : '' %> required>
        <span>I agree to the <a href="/terms" target="_blank" rel="noopener">Terms of Use</a> and <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>, and confirm I am authorised to post on behalf of the employers I add.</span>
      </label>
      <% if (errors.agree) { %><span class="error" id="err-agree"><%= errors.agree %></span><% } %>

      <div class="form-actions">
        <button class="kds-btn kds-btn--brand kds-btn--block" type="submit">Create consultant account</button>
      </div>
    </form>
    <p class="auth__foot">Already have an account? <a href="/login?role=consultant">Sign in</a></p>
  </div>
</section>
