<%- include('_head', { h: { eyebrow: 'Create your account', h1: 'Employer', leadHtml: 'Post jobs for your own company. Creating an account is free — you only pay when you publish a posting. <a href="/signup">Not an employer?</a>', crumb: 'Create your account' } }) %>
    <div class="auth__card">
      <%- include('_form-errors', { errors }) %>
      <form class="form" method="post" action="/signup/employer" novalidate>
        <h2 class="auth__section">About you</h2>
        <%- include('_field', { f: { name: 'name', label: 'Your full name', value: values.name, error: errors.name, autocomplete: 'name' } }) %>
        <div class="form-row">
          <%- include('_field', { f: { name: 'email', label: 'Work email', type: 'email', value: values.email, error: errors.email, autocomplete: 'email', inputmode: 'email' } }) %>
          <%- include('_field', { f: { name: 'phone', label: 'Phone', type: 'tel', value: values.phone, error: errors.phone, autocomplete: 'tel', inputmode: 'tel', required: false, placeholder: '(416) 555-0100' } }) %>
        </div>
        <div class="form-row">
          <%- include('_password', { f: { name: 'password', label: 'Password', error: errors.password, hint: 'At least 8 characters, with a letter and a number.' } }) %>
          <%- include('_password', { f: { name: 'password_confirm', label: 'Confirm password', error: errors.password_confirm } }) %>
        </div>

        <h2 class="auth__section">Your company</h2>
        <div class="form-row">
          <%- include('_field', { f: { name: 'company_name', label: 'Legal company name', value: values.company_name, error: errors.company_name, autocomplete: 'organization', hint: 'The registered business name, as on your invoices.' } }) %>
          <%- include('_field', { f: { name: 'operating_name', label: 'Operating name', value: values.operating_name, error: errors.operating_name, required: false, placeholder: 'e.g. Flying Pig', hint: 'Operating / trade name — the name job seekers know you by. Shown first on your postings.' } }) %>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="industry">Industry <span class="req">*</span></label>
            <select class="input" id="industry" name="industry" required <% if (errors.industry) { %>aria-invalid="true" aria-describedby="err-industry"<% } else { %>aria-describedby="hint-industry"<% } %>>
              <option value="">Choose your industry…</option>
              <% C.INDUSTRIES.forEach(([k, n]) => { %><option value="<%= k %>" <%= values.industry === k ? 'selected' : '' %>><%= n %></option><% }) %>
            </select>
            <% if (errors.industry) { %><span class="error" id="err-industry"><%= errors.industry %></span><% } else { %><span class="hint" id="hint-industry">The sector your company operates in (Job Bank list).</span><% } %>
          </div>
          <%- include('_field', { f: { name: 'website', label: 'Website', type: 'url', value: values.website, error: errors.website, autocomplete: 'url', required: false, placeholder: 'https://www.example.ca', inputmode: 'url' } }) %>
        </div>

        <h2 class="auth__section">Business address</h2>
        <p class="small muted auth__section-note">Saved to your profile as your first work location. When you post a job you tick the locations it applies to — add as many as you need later.</p>
        <div class="form-row form-row--street">
          <div class="field">
            <label for="street_address">Street address <span class="req">*</span></label>
            <input class="input" id="street_address" name="street_address" type="text" value="<%= values.street_address ?? '' %>" required autocomplete="street-address" placeholder="123 Main St"
              data-address-autocomplete data-autofill="street=street_address,city=city,province=province,postal=postal_code"
              <% if (errors.street_address) { %>aria-invalid="true" aria-describedby="err-street_address"<% } else { %>aria-describedby="hint-street_address"<% } %>>
            <% if (errors.street_address) { %><span class="error" id="err-street_address"><%= errors.street_address %></span><% } else { %><span class="hint" id="hint-street_address">Start typing and pick your address to fill in the rest.</span><% } %>
          </div>
          <%- include('_field', { f: { name: 'unit', label: 'Unit / suite', value: values.unit, error: errors.unit, autocomplete: 'address-line2', required: false, placeholder: 'Unit 4' } }) %>
        </div>
        <div class="form-row form-row--3">
          <%- include('_field', { f: { name: 'city', label: 'City', value: values.city, error: errors.city, autocomplete: 'address-level2' } }) %>
          <div class="field">
            <label for="province">Province / territory <span class="req">*</span></label>
            <select class="input" id="province" name="province" required <% if (errors.province) { %>aria-invalid="true" aria-describedby="err-province"<% } %>>
              <option value="">Choose…</option>
              <% C.PROVINCES.forEach(([k, n]) => { %><option value="<%= k %>" <%= values.province === k ? 'selected' : '' %>><%= n %></option><% }) %>
            </select>
            <% if (errors.province) { %><span class="error" id="err-province"><%= errors.province %></span><% } %>
          </div>
          <%- include('_field', { f: { name: 'postal_code', label: 'Postal code', value: values.postal_code, error: errors.postal_code, autocomplete: 'postal-code', placeholder: 'A1A 1A1' } }) %>
        </div>

        <label class="check <%= errors.agree ? 'check--error' : '' %>" for="agree">
          <input type="checkbox" id="agree" name="agree" value="1" <%= values.agree ? 'checked' : '' %> required>
          <span>I agree to the <a href="/terms" target="_blank" rel="noopener">Terms of Use</a> and <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</span>
        </label>
        <% if (errors.agree) { %><span class="error" id="err-agree"><%= errors.agree %></span><% } %>

        <div class="form-actions">
          <button class="kds-btn kds-btn--accent kds-btn--block" type="submit">Create employer account</button>
        </div>
        <p class="small muted auth__note">Posting a job costs $14.99 per posting per month + GST. Creating an account is free — you only pay when you publish.</p>
      </form>
      <p class="auth__foot">Already have an account? <a href="/login?role=employer">Sign in</a></p>
    </div>
  </div>
</div>
