<%- include('_head', { h: { eyebrow: 'Free to join', h1: 'Create your account', lead: 'Choose the account type that fits you. You can change your details any time.' } }) %>
    <div class="signup-chooser">
    <div class="grid role-grid">
      <a class="card role-card role-card--employer" href="/signup/employer">
        <span class="role-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18"/></svg></span>
        <span class="role-card__title">Employer</span>
        <span class="role-card__desc">Post jobs for your own company. One company profile, unlimited postings at $14.99 per posting per month + GST.</span>
        <span class="role-card__cta">Sign up as an employer <span aria-hidden="true">→</span></span>
      </a>
      <a class="card role-card role-card--consultant" href="/signup/consultant">
        <span class="role-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
        <span class="role-card__title">Third Party Consultant</span>
        <span class="role-card__desc">Manage postings for many employers under one login — $9.99 per posting per month + GST. Add a profile for each client you represent.</span>
        <span class="role-card__cta">Sign up as a third party consultant <span aria-hidden="true">→</span></span>
      </a>
      <a class="card role-card role-card--seeker" href="/signup/seeker">
        <span class="role-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 15l2 2 4-4"/></svg></span>
        <span class="role-card__title">Job Seeker</span>
        <span class="role-card__desc">Upload your resume, apply online, get alerts. Always free — for your first internship or your next skilled role.</span>
        <span class="role-card__cta">Sign up as a job seeker <span aria-hidden="true">→</span></span>
      </a>
    </div>
    <p class="auth__foot">Already have an account? <a href="/login">Sign in</a></p>
    </div>
  </div>
</div>
