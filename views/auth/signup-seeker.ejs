<%- include('_head', { h: { eyebrow: 'Create your account', h1: 'Job Seeker', leadHtml: 'Upload your resume, apply online and get alerts. No fees, ever. <a href="/signup">Hiring instead?</a>', crumb: 'Create your account' } }) %>
    <div class="auth__card">
      <%- include('_form-errors', { errors }) %>
      <form class="form" method="post" action="/signup/seeker" novalidate>
        <%- include('_field', { f: { name: 'name', label: 'Your full name', value: values.name, error: errors.name, autocomplete: 'name' } }) %>
        <div class="form-row">
          <%- include('_field', { f: { name: 'email', label: 'Email', type: 'email', value: values.email, error: errors.email, autocomplete: 'email', inputmode: 'email' } }) %>
          <%- include('_field', { f: { name: 'phone', label: 'Phone', type: 'tel', value: values.phone, error: errors.phone, autocomplete: 'tel', inputmode: 'tel', required: false } }) %>
        </div>
        <div class="form-row">
          <%- include('_password', { f: { name: 'password', label: 'Password', error: errors.password, hint: 'At least 8 characters, with a letter and a number.' } }) %>
          <%- include('_password', { f: { name: 'password_confirm', label: 'Confirm password', error: errors.password_confirm } }) %>
        </div>
        <div class="form-row">
          <%- include('_field', { f: { name: 'city', label: 'City', value: values.city, error: errors.city, autocomplete: 'address-level2', required: false } }) %>
          <div class="field">
            <label for="province">Province / territory <span class="muted small">(optional)</span></label>
            <select class="input" id="province" name="province" <% if (errors.province) { %>aria-invalid="true" aria-describedby="err-province"<% } %>>
              <option value="">Choose…</option>
              <% C.PROVINCES.forEach(([k, n]) => { %><option value="<%= k %>" <%= values.province === k ? 'selected' : '' %>><%= n %></option><% }) %>
            </select>
            <% if (errors.province) { %><span class="error" id="err-province"><%= errors.province %></span><% } %>
          </div>
        </div>

        <label class="check" for="notify_email">
          <input type="checkbox" id="notify_email" name="notify_email" value="1" <%= values.notify_email ? 'checked' : '' %>>
          <span>Email me when new jobs match my profile. You can change this any time.</span>
        </label>

        <label class="check <%= errors.agree ? 'check--error' : '' %>" for="agree">
          <input type="checkbox" id="agree" name="agree" value="1" <%= values.agree ? 'checked' : '' %> required>
          <span>I agree to the <a href="/terms" target="_blank" rel="noopener">Terms of Use</a> and <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</span>
        </label>
        <% if (errors.agree) { %><span class="error" id="err-agree"><%= errors.agree %></span><% } %>

        <div class="form-actions">
          <button class="kds-btn kds-btn--accent kds-btn--block" type="submit">Create job seeker account</button>
        </div>
      </form>
      <p class="auth__foot">Already have an account? <a href="/login?role=seeker">Sign in</a></p>
    </div>
  </div>
</div>
