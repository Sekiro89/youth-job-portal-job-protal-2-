<%# Password input with show/hide toggle (public/js/auth.js). locals: name, label, error?, hint?, autocomplete? %>
<% const f = { error: '', hint: '', autocomplete: 'new-password', ...locals.f }; %>
<div class="field">
  <label for="<%= f.name %>"><%= f.label %> <span class="req">*</span></label>
  <div class="pw">
    <input class="input" id="<%= f.name %>" name="<%= f.name %>" type="password" required autocomplete="<%= f.autocomplete %>" minlength="8"
      <% if (f.error) { %>aria-invalid="true" aria-describedby="err-<%= f.name %>"<% } else if (f.hint) { %>aria-describedby="hint-<%= f.name %>"<% } %>>
    <button class="pw__toggle" type="button" aria-pressed="false" aria-label="Show password" data-pw-toggle="<%= f.name %>">Show</button>
  </div>
  <% if (f.error) { %><span class="error" id="err-<%= f.name %>"><%= f.error %></span><% } else if (f.hint) { %><span class="hint" id="hint-<%= f.name %>"><%= f.hint %></span><% } %>
</div>
