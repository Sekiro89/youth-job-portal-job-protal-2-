<% const roles = [['employer', 'Employer'], ['consultant', 'Partner'], ['seeker', 'Job Seeker']]; %>
<%- include('_head', { h: { eyebrow: 'Your next move', h1: 'Doesn\'t have to start over.', lead: 'Welcome back. Pick up where you left off.', split: true, plainEyebrow: true } }) %>
    <div class="auth__card">
      <% if (roleHint) { %>
      <div class="role-hints" aria-label="Account type">
        <% roles.forEach(([k, n]) => { %><a class="role-hint <%= roleHint === k ? 'is-active' : '' %>" href="/login?role=<%= k %>" <%= roleHint === k ? 'aria-current="true"' : '' %>><%= n %></a><% }) %>
      </div>
      <% } %>
      <%- include('_form-errors', { errors }) %>
      <form class="form" method="post" action="/login" novalidate>
        <%- include('_field', { f: { name: 'email', label: 'Email', type: 'email', value: values.email, autocomplete: 'email', inputmode: 'email' } }) %>
        <div class="field">
          <div class="split"><label for="password">Password</label><a class="small" href="/forgot">Forgot password?</a></div>
          <div class="pw">
            <input class="input" id="password" name="password" type="password" required autocomplete="current-password">
            <button class="pw__toggle" type="button" aria-pressed="false" aria-label="Show password" data-pw-toggle="password">Show</button>
          </div>
        </div>
        <label class="check" for="remember">
          <input type="checkbox" id="remember" name="remember" value="1" <%= values.remember ? 'checked' : '' %>>
          <span>Keep me signed in for 30 days</span>
        </label>
        <div class="form-actions">
          <button class="kds-btn kds-btn--accent kds-btn--block" type="submit">Sign in →</button>
        </div>
      </form>
      <div class="auth-newhere">
        <p class="eyebrow">New to Youth Futures?</p>
        <a class="auth-cta-link" href="/signup">Create an account <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</div>
